<https://vocab.destiny-evidence.org/methods/DSNY000201> a skos:Concept ;
    skos:altLabel "SR",
        "Systematic literature review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A review that uses explicit, reproducible methods to systematically search, select, appraise, and synthesise evidence from primary studies on a defined research question." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Systematic reviews" ;
    skos:scopeNote "Concept describes different systematic review types, such as evidence gap maps, mixed-methods reviews, rapid reviews, etc. For \"Systematic review\", please use child concept \"Full systematic review\"." .

<https://vocab.destiny-evidence.org/methods/DSNY000206> a skos:Concept ;
    skos:altLabel "Literature review",
        "Non-systematic review",
        "Review",
        "Traditional review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A non-systematic review that summarises and interprets the literature on a topic based on the author's expertise and judgement, without exhaustive or reproducible search methods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Narrative review" .

<https://vocab.destiny-evidence.org/methods/DSNY000207> a skos:Concept ;
    skos:altLabel "Clinical guideline",
        "Clinical practice guideline (CPG)",
        "Evidence-based guideline",
        "Health guideline",
        "Public health guideline" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A systematically developed statement providing recommendations to guide clinical or public health practice, typically based on a synthesis of the available evidence. Often with systematic methods, but sometimes also based on expert consensus." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Guideline (clinical or public health)" .

<https://vocab.destiny-evidence.org/methods/DSNY000208> a skos:Concept ;
    skos:altLabel "HTA",
        "Health technology assessment" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A comprehensive policy-relevant evaluation of a health technology that typically includes clinical effectiveness, cost-effectiveness, and broader social and ethical considerations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Health technology assessment (HTA)" ;
    skos:scopeNote "A broader evaluation of a health technology (drug, device, or intervention) used for policy and decision-making. Typically includes: clinical effectiveness (often via a systematic review), cost-effectiveness (economic modelling), ethical, legal, and social implications, and organisational impact." .

<https://vocab.destiny-evidence.org/methods/DSNY000515> a skos:Concept ;
    skos:altLabel "Descriptive designs",
        "Descriptive study design",
        "Single-group study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Study designs that describe characteristics, frequency, or distribution of outcomes in a single group without a comparison group or temporal manipulation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Descriptive / single-group designs" .

<https://vocab.destiny-evidence.org/methods/DSNY000519> a skos:Concept ;
    skos:altLabel "Observational single-group study",
        "Single-group observational study",
        "Uncontrolled observational design" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Observational study designs that track outcomes over time in a single group without a concurrent comparison group, relying on temporal patterns to infer associations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Observational / single-group designs" .

<https://vocab.destiny-evidence.org/methods/DSNY000522> a skos:Concept ;
    skos:altLabel "Analytic observational design",
        "Comparative observational design",
        "Observational comparative study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Observational study designs that compare health outcomes between two or more groups defined by exposure status, without random allocation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Observational / group comparison designs" .

<https://vocab.destiny-evidence.org/methods/DSNY000527> a skos:Concept ;
    skos:altLabel "Single-arm experimental design",
        "Uncontrolled experimental design" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Experimental study designs in which an intervention is applied to a single group without a concurrent control group, limiting but not eliminating causal inference." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "(Quasi-)Experimental / single-group designs" .

<https://vocab.destiny-evidence.org/methods/DSNY000529> a skos:Concept ;
    skos:altLabel "Comparative experimental design",
        "Controlled experimental design",
        "Group comparison experiment" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Experimental study designs that compare outcomes between an intervention group and one or more control or comparison groups, with or without randomisation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "(Quasi-)Experimental / group comparison designs" .

<https://vocab.destiny-evidence.org/methods/DSNY000541> a skos:Concept ;
    skos:altLabel "Mixed-methods design",
        "Qualitative design",
        "Qualitative research",
        "Qualitative study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Study designs using qualitative data collection and analysis to explore meanings, experiences, and contextual factors." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Qualitative designs" .

<https://vocab.destiny-evidence.org/methods/DSNY000544> a skos:Concept ;
    skos:altLabel "Mixed-methods study",
        "Multi-method study",
        "Quantitative and qualitative combined" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "A research design that integrates quantitative and qualitative data collection and analysis within a single study, combining the strengths of both approaches to address research questions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Mixed-methods" .

<https://vocab.destiny-evidence.org/methods/DSNY000545> a skos:Concept ;
    skos:altLabel "Computational modelling",
        "Mathematical modelling",
        "Modelling study",
        "Simulation study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Study designs using mathematical, statistical, or computational models to simulate real-world systems, project future outcomes, or estimate impacts under defined scenarios." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Modelling / simulation" .

<https://vocab.destiny-evidence.org/methods/DSNY000551> a skos:Concept ;
    skos:altLabel "Other design",
        "Other primary study design",
        "Unclassified study design" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Primary research study designs not captured by the specific categories of descriptive, observational, experimental, qualitative, or modelling designs." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Z_Other study design" .

<https://vocab.destiny-evidence.org/methods/DSNY000555> a skos:Concept ;
    skos:altLabel "Other review type",
        "Other synthesis type",
        "Unclassified evidence synthesis" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "Evidence synthesis types not captured by the specific categories of systematic review, umbrella review, narrative review, guideline, or health technology assessment." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Z_Other evidence synthesis type" .

<https://vocab.destiny-evidence.org/methods/DSNY000637> a skos:Concept ;
    skos:altLabel "Meta-analysis without systematic review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition """Advanced quantitative synthesis of existing studies conducted without systematic review methods for searching, selecting, and assessing evidence.
""" ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Meta-analysis (unsystematic)" ;
    skos:scopeNote "Typically distinguished from systematic reviews with meta-analyses because the statistical methods may be rigorous, but the evidence identification and selection process is not systematic or reproducible. Often occuring in Economics." .

