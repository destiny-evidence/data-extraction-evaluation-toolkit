""" ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "International / multilateral agreements" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000089> a skos:Concept ;
    skos:altLabel "Carbon pricing",
        "Economic incentives",
        "Economic instruments",
        "Financial instruments" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000087> ;
