    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Respiratory infections mortality (including tuberculosis)" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000308> a skos:Concept ;
    skos:altLabel "Diarrhoeal mortality",
        "Enteric infection death",
        "Waterborne disease mortality" ;
