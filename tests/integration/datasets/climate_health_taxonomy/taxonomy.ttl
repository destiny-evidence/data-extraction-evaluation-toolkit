""" ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Fiscal / incentive policy" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000090> a skos:Concept ;
    skos:altLabel "Climate governance",
        "Climate targets",
        "Heat health action plans",
        "Land use policy",
        "National adaptation plans",
        "National determined contributions",
        "Strategic planning",
        "Urban planning policy" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000087> ;
    skos:definition "Institutional frameworks, strategies, and targets that guide governments and organisations in planning and implementing climate action, including national determined contributions, national adaptation plans and climate plans (e.g. land use policy, city-level climate health strategies, spatial planning, urban heat island reduction, flood plain management), surveillance and early-warning policy (mandated disease surveillance, heat alert systems), climate-change related public health information and education." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "National / subnational policy" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000092> a skos:Concept ;
    skos:altLabel "Climate regulation",
        "Legal instruments",
        "Legislative instruments",
        "Standards" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000087> ;
    skos:definition "Legally binding rules, standards, and enforcement mechanisms that mandate emissions reductions, land use changes, or other climate-related behaviours by governments, industries, or individuals. E.g. emissions standards, environmental health regulations, fossil fuel bans." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Regulatory / legislative policy" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000099> a skos:Concept ;
