<https://vocab.destiny-evidence.org/topic/DSNY000054> a skos:Concept ;
    skos:altLabel "Causal attribution",
        "Climate attribution",
        "Event attribution" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000053> ;
    skos:definition "The process of establishing the causal contribution of climate change to observed changes in physical, ecological, or human systems, including specific extreme weather events or health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Attribution" ;
    skos:scopeNote "Refers to attribution as a high-level thematic area of climate research, encompassing the field of climate and health attribution broadly. Distinct from 'Attribution' in the Methods scheme, which classifies attribution as a specific study aim within primary research." .

<https://vocab.destiny-evidence.org/topic/DSNY000490> a skos:Concept ;
    skos:altLabel "Adaptive failure",
        "Counterproductive adaptation",
        "Failed adaptation",
        "Mal-adaptation" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000052> ;
    skos:definition "Adaptation actions that inadvertently increase vulnerability or exposure to harm, reduce adaptive capacity, or create new risks for human or natural systems, often as an unintended consequence of well-intentioned interventions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Maladaptation" .

