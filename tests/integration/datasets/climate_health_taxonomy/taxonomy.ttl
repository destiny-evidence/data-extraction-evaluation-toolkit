    dct:description "Via geoparser, will be automated in V2 of repository and display according to GeoNames (geographical database, https://www.geonames.org/). " ;
    dct:title "Geographic location [automation planned]" ;
    skos:hasTopConcept <https://vocab.destiny-evidence.org/geographic-location/DSNY000630> .

<https://vocab.destiny-evidence.org/geographic-location/DSNY000630> a skos:Concept ;
    skos:definition "Africa is the world's second-largest continent by area and population, comprising 55 sovereign countries on a single landmass connected to Asia via the Sinai Peninsula, bordered by the Mediterranean Sea, Atlantic Ocean, Indian Ocean, and Red Sea." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-location> ;
    skos:prefLabel "Africa (example)" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000127> a skos:Concept ;
    skos:altLabel "Earth-wide",
        "Planetary scale",
        "Worldwide" ;
    skos:definition "The highest level of governance, encompassing worldwide institutions, agreements, and processes that operate across all nations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Global (Governance scale)" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000128> a skos:Concept ;
    skos:altLabel "Regional bloc",
        "Regional body",
        "World region" ;
    skos:definition "Governance operating at a regional geographic scale spanning multiple countries within a formally defined geographic or institutional bloc, such as the European Union or the African Union." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "International - regional (Governance scale)" ;
    skos:scopeNote "Refers to governance within a formally defined geographic or institutional regional bloc spanning multiple countries, such as the European Union or the African Union. Distinct from 'Several countries', which refers to looser multi-country groupings without a formal regional structure." .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000131> a skos:Concept ;
    skos:altLabel "Country-level",
        "Federal",
        "State-level governance" ;
    skos:definition "Governance and policy implemented at the level of a single sovereign nation, including national legislation, strategic plans, and government-led programmes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "National (Governance scale)" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000132> a skos:Concept ;
    skos:altLabel "City-level",
        "Local",
        "Municipal" ;
    skos:definition "Governance at the local or municipal level, including city councils and district authorities responsible for planning, service delivery, and local policy implementation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Sub-national - local / municipal (Governance scale)" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000135> a skos:Concept ;
    skos:altLabel "Domestic level",
        "Individual level" ;
    skos:definition "The smallest unit of governance scale, referring to decisions and actions taken by individual people or households." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Z_Household / individual (Governance scale)" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000229> a skos:Concept ;
    skos:altLabel "Cross-national",
        "Multinational",
        "Plurilateral" ;
    skos:definition "Governance arrangements and interventions involving a defined group of countries acting together across national boundaries, such as bilateral partnerships or plurilateral coalitions, without necessarily sharing a geographic region or formal institutional structure." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "International - multi-country (Governance scale)" ;
    skos:scopeNote "Refers to a defined group of countries acting together, such as a bilateral partnership or plurilateral coalition, without necessarily sharing a geographic region or formal institutional structure. Distinct from 'International, Regional', which refers to geographically or institutionally defined regional blocs." .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000230> a skos:Concept ;
    skos:altLabel "Administrative region",
        "Devolved region",
        "Province" ;
    skos:definition "Governance at the level of regions or provinces within a single country, such as states, counties, or devolved administrations with defined policy responsibilities." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Sub-national - regional (Governance scale)" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000261> a skos:Concept ;
    skos:altLabel "Extreme heat",
        "Heat exposure",
        "Heatwave exposure",
        "Thermal comfort",
        "Thermal load",
        "Thermal stress" ;
    skos:definition "Physiological strain placed on the body by elevated ambient temperature and humidity, impairing thermoregulation and increasing the risk of heat-related illness." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Heat stress (Exposure)" ;
    skos:scopeNote """As the planet warms, heat waves are becoming more frequent and lasting longer — placing people at increased risk for heat-related illnesses such as heat stroke. Heat-related illness can be seen at temperatures much lower than those characteristic of a heat wave. Health impacts: heat-related illness and death.
""" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000262> a skos:Concept ;
    skos:altLabel "Air pollutants",
        "Air pollution",
        "Ambient air quality",
        "Indoor air quality",
        "PM10 exposure",
        "PM2.5 exposure",
        "Particulate matter exposure" ;
    skos:definition "Exposure to outdoor or indoor air containing pollutants — including particulate matter, ozone, nitrogen dioxide, and wildfire smoke — at concentrations harmful to health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Air quality (Exposure)" ;
    skos:scopeNote """Air quality deteriorates with climate change through many pathways. 1. Hotter temperatures result in higher levels of ground-level ozone, wildfires result in increased levels of particulate matter and other air pollutants, and plants produce more pollen and allergens as a result of higher CO2 concentrations in the atmosphere. Increased pollen concentrations in the air also result from spread of certain heat- and drought-resistant plant species due to climate change (e.g. ragweed, Ambrosia artemisiifolia). 2. In addition to releasing CO2, the burning or combustion of fossil fuels releases particulate air pollutants. 3. Household (indoor) air pollution (from combustion of fossil fuels used for cooking and heating) is a major contributor to ambient (outdoor) air pollution. Biomass burning (in agricultural production) also causes air pollution. 4. Include indoor air-pollution only if related to fossil fuel combustion. 5. Radon is considered an air quality related exposure which can occur indoor and outdoor (it is related to open mines and can be exacerbated by heat). 6. There is an increase in sand and dust storms due to climate change, which contributes to air pollution. 

Examples of health impacts of this exposure: Exacerbations of asthma and other respiratory diseases (COPD); respiratory allergies; cardiovascular diseases; bacterial meningitis and invasive bacterial disease (linked to airborne dust).



""" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000263> a skos:Concept ;
    skos:altLabel "Food safety",
        "Food security",
        "Food system disruption",
        "Nutritional availability" ;
    skos:definition "Disruptions or changes to the availability, accessibility, and safety of food, including impacts on nutrition, foodborne pathogen risk, and agricultural productivity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Food supply and safety (Exposure)" ;
    skos:scopeNote """As atmospheric levels of CO2 increase, the nutritional value (protein and essential minerals) of vital food crops is impacted. Warmer temperatures and more extreme weather can also impair food safety (as climate-sensitive pathogens cause foodborne illness and chemical contamination) and distribution (e.g. by disrupting transportation). Food security (crop yields) can be affected by droughts and other extreme weather events, especially when related to essential crops (e.g. staple foods: cereals, grains, roots/tubers, legumes).

Examples of health impacts: undernutrition, salmonella food poisoning and other foodborne diseases, mycotoxin effects, diarrhoea (E.coli), diarrhoea (V. cholerae).
""" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000264> a skos:Concept ;
    skos:altLabel "Drinking water quality",
        "Flood water exposure",
        "Water availability",
        "Water contamination",
        "Water security" ;
    skos:definition "Changes in the availability, quality, and safety of freshwater and other water sources, including flooding, drought, and contamination affecting drinking water and sanitation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Water quality and quantity (Exposure)" ;
    skos:scopeNote """Climate change may compromise water quality through several pathways, such as favouring the growth of organisms that cause waterborne gastrointestinal illness and boosting the growth of harmful algae, Cyanobacteria, Escherichia coli and other bacterial strains, and viruses. Clean water may not even be available owing to drought or contamination after extreme weather, storm surges and floodings. Potential health impacts include: campylobacter infection, cholera, cryptosporidiosis, harmful algal blooms, leptospirosis, norovirus infection, typhoid fever, rotavirus infection, diarrhoea (E.coli), melioidosis, hepatitis E, dysentery.
""" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000265> a skos:Concept ;
    skos:altLabel "Cyclones",
        "Droughts",
        "Extreme weather",
        "Flooding",
        "Floods",
        "Hurricanes",
        "Hydrometeorological disasters",
        "Natural disasters",
        "Storms",
        "Tropical storms",
        "Typhoons",
        "Weather extremes",
        "Wildfires" ;
    skos:definition "Acute exposure to extreme meteorological events — including floods, storms, cyclones, droughts, and wildfires — that cause direct physical harm or injury." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Extreme weather events (Exposure)" ;
    skos:scopeNote "Extreme weather, including increasingly intense storms leading to coastal flooding with rising sea levels, can result in a wide range of health effects. These may include death or injuries, worsening of existing medical illnesses, spread of waterborne diseases, and adverse effects on mental health. Extreme events can also lead to wide-ranging negative consequences for health care delivery (disruption)." .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000266> a skos:Concept ;
    skos:altLabel "Disease vector range",
        "Mosquito distribution",
        "Tick distribution",
        "Vector ecology",
        "Vector-borne disease risk" ;
    skos:definition "Changes in the geographic range, abundance, and seasonal activity of vectors — such as mosquitoes, ticks and mites — that alter the transmission risk of vector-borne diseases." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Vector distribution and ecology (Exposure)" ;
    skos:scopeNote """Climate change is altering the geographic distributions and life cycles of insect vectors, such as mosquitoes, ticks and mites, which may increase the risk, incidence, or geographic range of some vector-borne diseases and the emergence of new diseases (e.g. climate-sensitive zoonotic diseases). Animal disease vectors also comprise other taxonomic groups than insects, e.g. ticks (mites, arachnids), other arthropods, and also mammals (e.g. bats, rats and mice). These changes have important implications for several diseases such as Chikungunya (vector: mosquitoes), dengue (vector: mosquitoes), encephalitis (e.g. tick-borne encephalitis, Japanese encephalitis, Murray Valley encephalitis, or West Nile encephalitis.), Hantavirus infection (vector: rodents), Lyme disease (vector: ticks), malaria (vector: mosquitoes), Rift Valley fever (vector: mosquitoes), West Nile virus infection (vector: mosquitoes), Zika virus infection (vector: mosquitoes), Ross River fever (vector: mosquitoes), Crimean-Congo haemorrhagic fever (vector: ticks), Leishmaniasis (vector: sandflies), Oropouche virus disease/fever (vector: midges, especially Culicoides paraensis). 


""" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000268> a skos:Concept ;
    skos:altLabel "Household crowding",
        "Housing conditions",
        "Housing quality",
        "Overcrowding",
        "Substandard housing" ;
    skos:broader <https://vocab.destiny-evidence.org/health-exposure/DSNY000267> ;
    skos:definition "Exposure to substandard, unsafe, or overcrowded living conditions that increase susceptibility to infectious disease, injury, and mental ill-health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Housing quality / overcrowding (Exposure)" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000269> a skos:Concept ;
    skos:altLabel "Economic hardship",
        "Financial loss",
        "Income loss",
        "Livelihood disruption",
        "Unemployment" ;
    skos:broader <https://vocab.destiny-evidence.org/health-exposure/DSNY000267> ;
    skos:definition "Economic disruption resulting in the loss of employment, income, or livelihoods, with downstream effects on food security, mental health, and access to healthcare." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Loss of livelihood / income (Exposure)" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000270> a skos:Concept ;
    skos:altLabel "Cultural disruption",
        "Cultural identity loss",
        "Loss of homeland",
        "Place attachment",
        "Solastalgia" ;
    skos:broader <https://vocab.destiny-evidence.org/health-exposure/DSNY000267> ;
    skos:definition "Psychological and social harm arising from disruption to a sense of belonging, cultural heritage, and connection to land or community — particularly relevant to indigenous and displaced populations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Loss of place attachment / cultural identity (Exposure)" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000271> a skos:Concept ;
    skos:altLabel "Climate migration",
        "Forced displacement",
        "Internal displacement",
        "Population displacement",
        "Refugee exposure" ;
    skos:broader <https://vocab.destiny-evidence.org/health-exposure/DSNY000267> ;
    skos:definition "Involuntary or forced movement of populations away from their homes due to environmental, conflict, or economic pressures, with associated health and social consequences." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Migration / forced displacement (Exposure)" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000272> a skos:Concept ;
    skos:altLabel "Armed conflict",
        "Civil unrest",
        "Conflict exposure",
        "Gender-based violence",
        "Political violence" ;
    skos:broader <https://vocab.destiny-evidence.org/health-exposure/DSNY000267> ;
    skos:definition "Exposure to interpersonal or collective violence, including armed conflict, gender-based violence, and civil unrest, as a determinant of physical and mental health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Violence / conflict (Exposure)" .

<https://vocab.destiny-evidence.org/health-exposure/DSNY000273> a skos:Concept ;
    skos:altLabel "Solar radiation",
        "Sun exposure",
        "UV exposure",
        "UV radiation",
        "Ultraviolet light" ;
    skos:definition "Exposure to ultraviolet radiation from solar sources, associated with skin cancer risk, vitamin D synthesis, and immune modulation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-exposure> ;
    skos:prefLabel "Ultraviolet / solar radiation (Exposure)" ;
    skos:scopeNote "Solar radiation increases with reduced cloud cover resulting from climate change. Exposure to ultraviolet (UV) radiation can cause sunburn, skin damage, eye damage and skin cancer. UV exposure is also related to the depletion of the ozone-layer, which is influenced by climate forcing agents." .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000275> a skos:Concept ;
    skos:altLabel "All-cause death rate",
        "Crude mortality rate",
        "Overall mortality",
        "Total mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "The rate of death from any cause within a defined population over a specified period, regardless of the underlying cause." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "All-cause mortality (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000276> a skos:Concept ;
    skos:altLabel "Cause-specific death rate",
        "Condition-specific mortality",
        "Disease-specific mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "The rate of death attributable to a specific disease, condition, or cause within a defined population." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Cause-specific mortality (Metric)" ;
    skos:scopeNote "E.g. diabetes-related mortality, cardiovascular mortality." .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000277> a skos:Concept ;
    skos:altLabel "Excess deaths",
        "Excess mortality rate",
        "Overall mortality burden" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "The number of deaths above the expected number of deaths in a population during a specific period. E.g. used to quantify the overall mortality burden of an event." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Excess mortality (Metric)" ;
    skos:scopeNote "Excess mortality does not inherently indicate the age or remaining life expectancy of those who died." .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000278> a skos:Concept ;
    skos:altLabel "Life years lost",
        "YLL" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "A measure of premature mortality calculated as the years of life lost due to death before a defined life expectancy threshold. E.g. used to quantify the loss of healthy lifetime caused by an exposure or event." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Years of life lost (YLL) (Metric)" ;
    skos:scopeNote "Premature mortality focuses on the timing of death relative to an expected lifespan. It therefore captures the severity of mortality impact in terms of lost lifetime, not the number of deaths above expectation." .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000279> a skos:Concept ;
    skos:altLabel "Child mortality",
        "Infant mortality rate",
        "Neonatal mortality rate",
        "Perinatal mortality",
        "Under-5 mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "Mortality rates among infants and children, typically measured as deaths per live births within specified age bands including neonatal, infant, and under-five periods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Infant / child mortality (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000280> a skos:Concept ;
    skos:altLabel "MMR",
        "Maternal death rate",
        "Maternal mortality ratio",
        "Pregnancy-related death" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "The death of a woman during pregnancy, childbirth, or within 42 days of delivery from causes related to or aggravated by the pregnancy or its management." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Maternal mortality (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000282> a skos:Concept ;
    skos:altLabel "Attack rate",
        "Case rate",
        "Disease incidence",
        "Incidence rate",
        "New cases" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000281> ;
    skos:definition "The rate at which new cases of a disease or condition occur in a defined population during a specified time period." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Incidence (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000283> a skos:Concept ;
    skos:altLabel "Disease prevalence",
        "Period prevalence",
        "Point prevalence",
        "Prevalence rate" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000281> ;
    skos:definition "The proportion of a defined population living with a disease or condition at a specific point in time or during a defined period." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Prevalence (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000284> a skos:Concept ;
    skos:altLabel "Disability years",
        "Non-fatal disease burden",
        "YLD",
        "Years with disability" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000281> ;
    skos:definition "A component of the Global Burden of Disease framework measuring the years of healthy life lost due to living with a non-fatal disease or disability, weighted by severity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Years lived with disability (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000285> a skos:Concept ;
    skos:altLabel "Burden of disease",
        "DALY",
        "DALYs",
        "Disability-adjusted life year" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000281> ;
    skos:definition "A summary measure of population health combining years of life lost to premature death (YLL) and years lived with disability (YLD), representing the total burden of disease." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Disability-adjusted life years (DALY) (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000286> a skos:Concept ;
    skos:altLabel "HRQoL",
        "Health status",
        "Patient-reported outcomes",
        "QoL",
        "Quality of life",
        "Wellbeing" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000281> ;
    skos:definition "Self-reported or assessed measures of physical, mental, and social functioning and wellbeing as affected by a health condition or its treatment." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "(Health-related) quality of life (HrQoL/QoL) (Metric)" ;
    skos:scopeNote "Ideally assessed using a validated instrument, such as SF-36, SF-12, SF-8, WHOQOL-BREF, WHOQOL-100, PROMIS Global Health, EQ-5D, AQoL, Health Utilities Index, 15D o Quality of Well-Being Scale." .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000288> a skos:Concept ;
    skos:altLabel "Hospital stay",
        "Hospitalisation",
        "Inpatient admission",
        "Inpatient care" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000287> ;
    skos:definition "The rate or number of patients admitted to hospital as inpatients for treatment, observation, or care related to a specific condition." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Hospital admission (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000289> a skos:Concept ;
    skos:altLabel "A&E attendance",
        "Accident and emergency",
        "ED visit",
        "Emergency care attendance",
        "Emergency visit" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000287> ;
    skos:definition "The rate or number of attendances at emergency departments for acute assessment and treatment, used as an indicator of urgent health need." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Emergency department visit (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000290> a skos:Concept ;
    skos:altLabel "Ambulatory care visit",
        "Clinic visit",
        "GP visit",
        "Outpatient attendance",
        "Primary care visit" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000287> ;
    skos:definition "The rate or number of non-emergency contacts with primary care or outpatient services, including general practice, specialist clinics, and community health settings." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Outpatient / primary care visit (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000291> a skos:Concept ;
    skos:altLabel "Access disruption",
        "Health system disruption",
        "Healthcare disruption",
        "Service disruption" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000287> ;
    skos:definition "Interruptions to the availability or accessibility of healthcare services, resulting in delayed, reduced, or foregone care for affected populations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Healthcare access disruption (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000292> a skos:Concept ;
    skos:altLabel "Bed days",
        "Hospital length of stay",
        "Inpatient duration",
        "LOS" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000287> ;
    skos:definition "The duration of an inpatient hospital episode, used as a measure of disease severity, healthcare resource use, and patient recovery." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Length of hospital stay (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000294> a skos:Concept ;
    skos:altLabel "Attributable burden",
        "Attributable risk",
        "PAF",
        "Population attributable fraction" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000293> ;
    skos:definition "The proportion of disease cases or deaths in a population attributable to a specific exposure, estimating the potential reduction in burden if the exposure were eliminated." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Attributable fraction / risk (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000295> a skos:Concept ;
    skos:altLabel "HR",
        "Hazard ratio",
        "OR",
        "Odds ratio",
        "RR",
        "Relative risk",
        "Risk ratio" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000293> ;
    skos:definition "Statistical measures comparing the probability of a health outcome between exposed and unexposed groups, used to quantify the strength of association between an exposure and an outcome." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Relative risk / odds ratio (Metric)" .

<https://vocab.destiny-evidence.org/health-metrics/DSNY000631> a skos:Concept ;
    skos:altLabel "PYLL",
        "Premature mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-metrics/DSNY000274> ;
    skos:definition "Uses a fixed reference age and measures years lost due to premature death." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-metrics> ;
    skos:prefLabel "Potential years of life lost (PYLL) (Metric)" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000297> a skos:Concept ;
    skos:altLabel "All-cause death",
        "Overall mortality",
        "Total deaths" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000296> ;
    skos:definition "Deaths from any cause combined, used as an overall measure of fatal burden without attribution to a specific disease or condition." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "1.1. Total / all-cause mortality (Outcome)" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000299> a skos:Concept ;
    skos:altLabel "CVD mortality",
        "Cardiovascular death",
        "Heart disease mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298> ;
    skos:definition "Deaths attributable to diseases of the heart and circulatory system, including ischemic heart disease, stroke, and heart failure." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Cardiovascular mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000300> a skos:Concept ;
    skos:altLabel "Cancer death",
        "Cancer mortality",
        "Tumour-related mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298> ;
    skos:definition "Deaths attributable to malignant and benign neoplasms across all anatomical sites." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Neoplasms mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000301> a skos:Concept ;
    skos:altLabel "Asthma mortality",
        "COPD mortality",
        "Respiratory disease mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298> ;
    skos:definition "Deaths attributable to chronic conditions of the respiratory tract, including chronic obstructive pulmonary disease and asthma." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Chronic respiratory diseases mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000302> a skos:Concept ;
    skos:altLabel "Diabetes mortality",
        "Kidney disease mortality",
        "Renal mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298> ;
    skos:definition "Deaths attributable to diabetes mellitus and chronic kidney disease, which frequently co-occur and share common risk pathways." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Diabetes and kidney diseases mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000303> a skos:Concept ;
    skos:altLabel "Disaster mortality",
        "Injury mortality",
        "Trauma death",
        "Violence-related mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298> ;
    skos:definition "Deaths resulting from injuries including drowning, fires, natural disasters, suicide, and interpersonal violence." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Injury-related mortality (drowning, fires, disasters, suicide, violence)" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000304> a skos:Concept ;
    skos:altLabel "Other NCD mortality",
        "Other non-communicable mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298> ;
    skos:definition "Deaths attributable to non-communicable diseases not classified under the major NCD categories of cardiovascular, respiratory, neoplastic, or metabolic disease." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Other non-communicable diseases mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000307> a skos:Concept ;
    skos:altLabel "Pneumonia mortality",
        "Respiratory infection mortality",
        "TB mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000306> ;
