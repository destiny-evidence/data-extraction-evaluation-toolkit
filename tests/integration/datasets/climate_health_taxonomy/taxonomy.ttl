<https://vocab.destiny-evidence.org/health-outcomes/DSNY000313> a skos:Concept ;
    skos:altLabel "Malnutrition mortality",
        "Nutrition-related death",
        "Undernutrition death" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000305> ;
    skos:definition "Deaths attributable to nutritional deficiencies and undernutrition, including protein-energy malnutrition and micronutrient deficiency disorders." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
