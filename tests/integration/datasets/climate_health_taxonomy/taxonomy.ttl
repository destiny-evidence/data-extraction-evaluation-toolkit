    skos:inScheme <https://vocab.destiny-evidence.org/human-settlements> ;
    skos:prefLabel "4. Towns" .

<https://vocab.destiny-evidence.org/human-settlements/DSNY000507> a skos:Concept ;
    skos:altLabel "100,000 to 1 million",
        "Medium cities",
        "Mid-sized cities",
        "Urban centres" ;
    skos:broader <https://vocab.destiny-evidence.org/human-settlements/DSNY000505> ;
    skos:definition "Formal urban settlements with a population of between 100,000 and 1,000,000 inhabitants, with established administrative systems, diverse economies, and relatively comprehensive urban infrastructure." ;
    skos:inScheme <https://vocab.destiny-evidence.org/human-settlements> ;
    skos:prefLabel "3. Cities" .

<https://vocab.destiny-evidence.org/human-settlements/DSNY000508> a skos:Concept ;
