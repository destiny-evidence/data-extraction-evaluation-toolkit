<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000587> a skos:Concept ;
    skos:altLabel "Other institutional response",
        "Other organisational measure",
        "Other system-level intervention" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000114> ;
    skos:definition "Institutional interventions not classified under health system governance, research and education, emergency management, or international development and aid." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Z_Other institution-based interventions" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000589> a skos:Concept ;
    skos:altLabel "Community-led adaptation",
        "Grassroots adaptation",
        "Local adaptation",
        "Locally led climate action" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000588> ;
    skos:definition "Locally designed and led responses to climate-health risks, drawing on community knowledge and priorities to develop contextually appropriate adaptation strategies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Community-based adaptation" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000590> a skos:Concept ;
    skos:altLabel "Community engagement",
        "Community planning",
        "Inclusive governance",
        "Participatory decision-making" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000588> ;
    skos:definition "Processes that involve communities in decision-making and planning, ensuring local voices shape policies, programmes, and strategies that affect them." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Participatory governance" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000591> a skos:Concept ;
    skos:altLabel "Community resilience",
        "Mutual aid",
        "Social support networks",
        "Solidarity networks" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000588> ;
    skos:definition "Community networks and informal support systems that enable mutual assistance during times of stress or shock, including food sharing, community care, and grassroots first response." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Social cohesion / mutual aid" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000592> a skos:Concept ;
    skos:altLabel "Connection to land",
        "Cultural resilience",
        "Indigenous knowledge",
        "Indigenous-led response",
        "Traditional ecological knowledge" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000588> ;
    skos:definition "Culturally grounded practices, knowledge systems, and identities that support individual and community wellbeing, including indigenous-led approaches and the preservation of connections to land and heritage." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Cultural identity" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000593> a skos:Concept ;
    skos:altLabel "Community land tenure",
        "Indigenous land rights",
        "Land tenure security",
        "Resource rights",
        "Territorial rights" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000588> ;
    skos:definition "The legal and customary rights of communities and indigenous peoples to access, use, and govern land and natural resources, underpinning livelihood security and self-determination." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Land / resource rights" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000594> a skos:Concept ;
    skos:altLabel "Other community intervention",
        "Other community-based response",
        "Other grassroots action" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000588> ;
    skos:definition "Community-based interventions not classified under community-based adaptation, participatory governance, social cohesion, cultural identity, or land and resource rights." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Z_Other community-based interventions" ;
    skos:scopeNote "Note that \"Institutional\" > \"Health systems and public health\" > \"Other public health response\" is used for public health interventions addressing entire populations." .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000643> a skos:Concept ;
    skos:altLabel "Immunization",
        "Vaccines" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000642> ;
    skos:definition "Development, trial, deployment, or uptake of vaccines targeting a disease whose burden, distribution, or transmission is influenced by climate change (e.g., a vaccine against a climate-sensitive vector-borne or water-borne disease)." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Vaccines and immunization" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000644> a skos:Concept ;
    skos:altLabel "Climate-sensitive medication",
        "Drug storage",
        "Thermal stability" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000642> ;
    skos:definition "Drugs, treatments, or medical countermeasures (curative or preventive, e.g., prophylactics) developed or used to manage a climate-sensitive health condition. Also encompasses adaptation of medication to climatic conditions (e.g. heat)." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Therapeutics and pharmaceuticals" ;
    skos:scopeNote "Also encompasses adaptation of drug storage to heat and thermal stability assessment of drugs." .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000645> a skos:Concept ;
    skos:altLabel "Disease surveillance platforms",
        "Rapid diagnostic tests" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000642> ;
    skos:definition "Tools, tests, or systems used to detect, monitor, or track a climate-sensitive disease or health condition in individuals or populations (e.g., rapid diagnostic tests, disease surveillance platforms, early-warning systems tied to clinical/case data)." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Diagnostics and surveillance tools" ;
    skos:scopeNote "Surveillance tools for vector control have their distinct category." .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000646> a skos:Concept ;
    skos:altLabel "Bed nets",
        "Vector surveillance" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000642> ;
    skos:definition "Chemical (e.g., insecticides, larvicides), biological (e.g., sterile insect technique, biocontrol agents), environmental (e.g., habitat modification, bed nets), or public health measures aimed at reducing exposure to disease vectors whose range or behaviour is affected by climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Vector control" ;
    skos:scopeNote "Vector surveillance is part of this concept." .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000647> a skos:Concept ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000642> ;
    skos:definition "Any other biomedical or clinical intervention addressing a climate-sensitive health outcome that does not fit the categories above." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Z_Other clinical / biomedical interventions" .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000648> a skos:Concept ;
    skos:altLabel "Health education campaigns",
        "Heat health action plans",
        "Heat health warning systems",
        "Public health advisory" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000642> ;
    skos:definition "Population-level public health measures addressing a climate-sensitive health outcome that are not biomedical/clinical products in themselves (e.g., heat-health action plans, health advisories/warnings, mass health education campaigns, outbreak response coordination) and do not fit the categories above." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-responses-solutions> ;
    skos:prefLabel "Z_Other public health response" .

<https://vocab.destiny-evidence.org/methods/DSNY000200> a skos:Concept ;
    skos:altLabel "Meta-review",
        "Overview of reviews",
        "Review of reviews" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A synthesis that systematically compiles and summarises findings from multiple systematic reviews on a related topic, providing a high-level overview of the evidence base." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Umbrella review / overview of reviews" .

<https://vocab.destiny-evidence.org/methods/DSNY000202> a skos:Concept ;
    skos:altLabel "Comprehensive systematic review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review conducted with comprehensive search strategies and full methodological rigour, without time or resource constraints that would limit its scope." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Systematic review" ;
    skos:scopeNote "With or without meta-analysis. Distinct from the parent category \"Systematic reviews\", which encompasses more types of specific systematic reviews." .

<https://vocab.destiny-evidence.org/methods/DSNY000203> a skos:Concept ;
    skos:altLabel "Accelerated review",
        "Fast-track review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review conducted within a shortened timeframe using streamlined methods, trading some comprehensiveness for speed to meet urgent policy or practice needs." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Rapid review" .

<https://vocab.destiny-evidence.org/methods/DSNY000204> a skos:Concept ;
    skos:altLabel "Evidence map",
        "Scoping study",
        "Systematic map" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review that maps the extent, range, and nature of evidence on a broad topic without synthesising findings, used to identify gaps and inform future research priorities." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Scoping review" .

<https://vocab.destiny-evidence.org/methods/DSNY000205> a skos:Concept ;
    skos:altLabel "Evidence gap map",
        "Gap map" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic mapping exercise that visually represents the distribution of evidence across a framework of interventions and outcomes, highlighting areas where evidence is absent or weak." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Evidence map / evidence gap map" .

<https://vocab.destiny-evidence.org/methods/DSNY000206> a skos:Concept ;
    skos:altLabel "Literature review",
        "Non-systematic review",
        "Review",
        "Traditional review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A non-systematic review that summarises and interprets the literature on a topic based on the author's expertise and judgement, without exhaustive or reproducible search methods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Narrative review" .

<https://vocab.destiny-evidence.org/methods/DSNY000207> a skos:Concept ;
    skos:altLabel "Clinical guideline",
        "Evidence-based guideline",
        "Health guideline",
        "Public health guideline" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A systematically developed statement providing recommendations to guide clinical or public health practice, typically based on a synthesis of the available evidence. Often with systematic methods, but sometimes also based on expert consensus." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Guideline (clinical or public health)" .

<https://vocab.destiny-evidence.org/methods/DSNY000208> a skos:Concept ;
    skos:altLabel "HTA",
        "Health technology assessment" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "A comprehensive policy-relevant evaluation of a health technology that typically includes clinical effectiveness, cost-effectiveness, and broader social and ethical considerations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Health technology assessment (HTA)" ;
    skos:scopeNote "A broader evaluation of a health technology (drug, device, or intervention) used for policy and decision-making. Typically includes: clinical effectiveness (often via a systematic review), cost-effectiveness (economic modelling), ethical, legal, and social implications, and organisational impact." .

<https://vocab.destiny-evidence.org/methods/DSNY000516> a skos:Concept ;
    skos:altLabel "Case report",
        "Case study",
        "Clinical case report",
        "Single case report" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000515> ;
    skos:definition "A detailed account of a single individual's or unit's exposure, condition, and outcome, used to generate hypotheses or describe novel or rare phenomena." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Case report / case study" .

<https://vocab.destiny-evidence.org/methods/DSNY000517> a skos:Concept ;
    skos:altLabel "Cross-sectional study",
        "Prevalence study",
        "Single-round survey",
        "Survey study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000515> ;
    skos:definition "A study design that collects data from a population at a single point in time, describing the prevalence of exposures and outcomes without follow-up." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Cross-sectional / single-round survey" .

<https://vocab.destiny-evidence.org/methods/DSNY000518> a skos:Concept ;
    skos:altLabel "Case series",
        "Descriptive multi-case study",
        "Patient series" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000515> ;
    skos:definition "A descriptive report of characteristics and outcomes among a series of individuals sharing a common exposure or condition, without a control group." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Case series / descriptive multi-case study" .

<https://vocab.destiny-evidence.org/methods/DSNY000520> a skos:Concept ;
    skos:altLabel "Before-after study",
        "Pre-post comparison",
        "Pre-post design",
        "Pre-post study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000519> ;
    skos:definition "A study that compares outcomes measured in the same group before and after an exposure or intervention, without a concurrent control group." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Before-after / pre-post study" .

<https://vocab.destiny-evidence.org/methods/DSNY000521> a skos:Concept ;
    skos:altLabel "ITS (uncontrolled)",
        "Single-group interrupted time series",
        "Uncontrolled ITS" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000519> ;
    skos:definition "A time series analysis of outcome data at multiple time points before and after an intervention or exposure in a single group, without a control series to account for concurrent trends." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Interrupted time series (uncontrolled)" .

<https://vocab.destiny-evidence.org/methods/DSNY000523> a skos:Concept ;
    skos:altLabel "Case-control study",
        "Matched case-control",
        "Matched sample design",
        "Retrospective matched comparison" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000522> ;
    skos:definition "A study that retrospectively compares individuals with a health outcome (cases) to those without (controls) to identify differences in prior exposure, often using matching to reduce confounding." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Case-control / mached sample design" .

<https://vocab.destiny-evidence.org/methods/DSNY000524> a skos:Concept ;
    skos:altLabel "Cohort study",
        "Longitudinal study",
        "Panel study",
        "Prospective cohort",
        "Retrospective cohort" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000522> ;
    skos:definition "A study that follows a defined group of individuals over time, measuring exposures and outcomes prospectively or retrospectively to assess associations and temporal relationships." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Cohort / panel data / longitudinal study" .

<https://vocab.destiny-evidence.org/methods/DSNY000525> a skos:Concept ;
    skos:altLabel "CBA",
        "Controlled pre-post study",
        "Non-randomised controlled before-after" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000522> ;
    skos:definition "A study comparing pre- and post-intervention outcomes in both an intervention group and a non-randomised control group, improving on uncontrolled before-after designs by accounting for secular trends." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Controlled before-after (CBA)" .

<https://vocab.destiny-evidence.org/methods/DSNY000526> a skos:Concept ;
    skos:altLabel "Controlled ITS",
        "Controlled interrupted time series",
        "ITS (controlled)" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000522> ;
    skos:definition "A time series analysis comparing outcome trends before and after an intervention or exposure in both an intervention group and a concurrent control group, strengthening causal inference over uncontrolled ITS." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Interrupted time series (controlled)" .

<https://vocab.destiny-evidence.org/methods/DSNY000528> a skos:Concept ;
    skos:altLabel "Open-label single-arm trial",
        "Single-arm study",
        "Single-arm trial",
        "Uncontrolled trial" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000527> ;
    skos:definition "An experimental study in which all participants receive the intervention and outcomes are compared to a pre-specified target or historical baseline, without a concurrent control arm." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Single arm trial / single arm experiment" .

<https://vocab.destiny-evidence.org/methods/DSNY000530> a skos:Concept ;
    skos:altLabel "Cluster RCT",
        "Crossover RCT",
        "Field experiment",
        "Parallel RCT",
        "RCT",
        "Randomised controlled trial" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000529> ;
    skos:definition "An experimental study in which participants are randomly allocated to intervention or control groups, considered the gold standard for evaluating causal effects of interventions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "1. Randomised (RCT)" .

<https://vocab.destiny-evidence.org/methods/DSNY000532> a skos:Concept ;
    skos:altLabel "Non-randomised controlled study",
        "Non-randomised study",
        "Observational quasi-experiment" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000529> ;
    skos:definition "An experimental study in which participants are allocated to intervention and comparison groups through a process other than randomisation, using statistical methods to control for confounding." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "3. Non-randomised" ;
    skos:scopeNote "Studies in which researchers assign the intervention, but not by random allocation." .

<https://vocab.destiny-evidence.org/methods/DSNY000533> a skos:Concept ;
    skos:altLabel "DD estimator",
        "DiD",
        "Diff-in-diff",
        "Difference-in-difference",
        "Event study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000531> ;
    skos:definition "A quasi-experimental method comparing the change in outcomes over time between a group exposed to an intervention and an unexposed control group, to estimate causal effects under the parallel trends assumption (similar to those of difference-in-differences)." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Difference-in-differences / event study" ;
    skos:scopeNote "Exploit externally determined variation in the timing or exposure to a policy, intervention, or event, rather than researcher-assigned interventions." .

<https://vocab.destiny-evidence.org/methods/DSNY000534> a skos:Concept ;
    skos:altLabel "IV analysis",
        "IV method",
        "Instrumental variable analysis",
        "Two-stage least squares" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000531> ;
    skos:definition "A quasi-experimental method using a variable that affects exposure but not the outcome directly (an instrument) to estimate causal effects in the presence of unmeasured confounding." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Instrumental variables" .

<https://vocab.destiny-evidence.org/methods/DSNY000535> a skos:Concept ;
    skos:altLabel "RD design",
        "RDD",
        "Regression discontinuity design" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000531> ;
    skos:definition "A quasi-experimental design exploiting a threshold in a continuous assignment variable to estimate causal effects for units just above and below the cutoff, where assignment is effectively random." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Regression discontinuity" .

<https://vocab.destiny-evidence.org/methods/DSNY000536> a skos:Concept ;
    skos:altLabel "Synthetic comparison group",
        "Synthetic control method" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000531> ;
    skos:definition "A quasi-experimental method constructing a weighted combination of untreated units to serve as a counterfactual for a treated unit, used when only a small number of aggregate units are available." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Synthetic control" .

<https://vocab.destiny-evidence.org/methods/DSNY000538> a skos:Concept ;
    skos:altLabel "Adjusted cohort analysis",
        "Fixed effects model",
        "Panel regression",
        "Two-way fixed effects",
        "Within-estimator" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000531> ;
    skos:definition "A regression approach using repeated observations on the same units over time to control for time-invariant unobserved confounding, including standard fixed effects, panel regression, and adjusted cohort analysis." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Fixed effects / panel regression" .

<https://vocab.destiny-evidence.org/methods/DSNY000539> a skos:Concept ;
    skos:altLabel "Coarsened exact matching",
        "Matched DiD",
        "Matched analysis",
        "PSM",
        "Propensity score analysis",
        "Propensity score matching" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000531> ;
    skos:definition "Quasi-experimental studies that compare changes over time between intervention and matched comparison groups, using matching methods (e.g., propensity scores) to improve group comparability and estimate intervention effects." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "(Propensity score) Matched differences-in-differences" ;
    skos:scopeNote "Uses matching and before-after comparisons between intervention and comparison groups." .

<https://vocab.destiny-evidence.org/methods/DSNY000540> a skos:Concept ;
    skos:altLabel "Allocation method unclear",
        "Randomisation not reported",
        "Unclear randomisation" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000529> ;
    skos:definition "An experimental or quasi-experimental study in which the method of allocation to groups is not clearly reported, precluding classification as randomised or non-randomised." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "4. Randomisation unclear" .

<https://vocab.destiny-evidence.org/methods/DSNY000542> a skos:Concept ;
    skos:altLabel "In-depth interviews",
        "Interview-based study",
        "Qualitative interviews" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000541> ;
    skos:definition "A qualitative research design using in-depth interviews to explore lived experiences, cultural practices, and social contexts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Interviews" ;
    skos:scopeNote "Interview-based research is defined by structured/semi-structured/unstructured interviews as the primary data source, often without any fieldwork or observational component at all (e.g., a study that recruits participants and interviews them once, with no immersion in their setting)." .

<https://vocab.destiny-evidence.org/methods/DSNY000543> a skos:Concept ;
    skos:altLabel "FGD",
        "Focus group discussion",
        "Group discussion",
        "Group interview" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000541> ;
    skos:definition "A qualitative method collecting data through facilitated group discussion among selected participants, used to explore shared perspectives, norms, and experiences on a defined topic." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Focus group" .

<https://vocab.destiny-evidence.org/methods/DSNY000544> a skos:Concept ;
    skos:altLabel "Mixed-methods study",
        "Multi-method study",
        "Quantitative and qualitative combined" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "A research design that integrates quantitative and qualitative data collection and analysis within a single study, combining the strengths of both approaches to address research questions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Mixed-methods" .

<https://vocab.destiny-evidence.org/methods/DSNY000546> a skos:Concept ;
    skos:altLabel "Climate-health projection model",
        "Health impact projection model",
        "IAM",
        "Integrated assessment model" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000545> ;
    skos:definition "A modelling approach linking climate, economic, and social systems to project future health impacts under different emissions or policy scenarios, often at national or global scale." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Integrated assessment model (IAM) / health impact projection" .

<https://vocab.destiny-evidence.org/methods/DSNY000547> a skos:Concept ;
    skos:altLabel "CGE",
        "CGE model",
        "Economy-wide model",
        "General equilibrium model" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000545> ;
    skos:definition "A macroeconomic modelling approach representing interactions across sectors of an economy to estimate the economy-wide effects of policy changes, including those with health implications." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Computable general equilibrium (CGE) model" .

<https://vocab.destiny-evidence.org/methods/DSNY000548> a skos:Concept ;
    skos:altLabel "Agent-based microsimulation",
        "Individual-level simulation",
        "Micro-level simulation" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000545> ;
    skos:definition "A modelling approach simulating the behaviour and outcomes of individual units — people, households, or firms — over time to estimate aggregate population-level effects of policies or exposures." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Microsimulation" .

<https://vocab.destiny-evidence.org/methods/DSNY000549> a skos:Concept ;
    skos:altLabel "Climate simulation",
        "Downscaled climate model",
        "Environmental modelling",
        "Other climate modelling" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000545> ;
    skos:definition "Climate or environmental modelling and simulation approaches not classified under IAM, CGE, or microsimulation, including downscaled climate models, exposure models, and environmental simulation tools." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Other climate-related modelling / simulation" .

<https://vocab.destiny-evidence.org/methods/DSNY000550> a skos:Concept ;
    skos:altLabel "Burden of disease model",
        "Disease model",
        "Epidemiological modelling",
        "Other health modelling",
        "Transmission model" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000545> ;
    skos:definition "Health modelling and simulation approaches not classified under IAM, CGE, or microsimulation, including epidemiological models, disease transmission models, and burden of disease projections." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Other health-related modelling / simulation" .

<https://vocab.destiny-evidence.org/methods/DSNY000551> a skos:Concept ;
    skos:altLabel "Other design",
        "Other primary study design",
        "Unclassified study design" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000167> ;
    skos:definition "Primary research study designs not captured by the specific categories of descriptive, observational, experimental, qualitative, or modelling designs." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Z_Other study design" .

<https://vocab.destiny-evidence.org/methods/DSNY000552> a skos:Concept ;
    skos:altLabel "Meta-ethnography",
        "Narrative synthesis of qualitative evidence",
        "QES",
        "Qualitative synthesis",
        "Thematic synthesis" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review that searches for, appraises, and synthesises findings from qualitative primary studies, using methods such as meta-ethnography, thematic synthesis, or framework synthesis." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Qualitative evidence synthesis" .

<https://vocab.destiny-evidence.org/methods/DSNY000553> a skos:Concept ;
    skos:altLabel "Realist evaluation review",
        "Realist synthesis",
        "Theory-driven review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A theory-driven review methodology that explores how and why interventions work in particular contexts and for whom, generating or testing explanatory theories rather than aggregating effect estimates." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Realist review" .

<https://vocab.destiny-evidence.org/methods/DSNY000554> a skos:Concept ;
    skos:altLabel "Convergent review",
        "Integrated review",
        "Mixed-methods systematic review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review that integrates findings from both quantitative and qualitative primary studies, using mixed-methods synthesis approaches to address questions that neither approach could answer alone." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Mixed-methods review" .

<https://vocab.destiny-evidence.org/methods/DSNY000555> a skos:Concept ;
    skos:altLabel "Other review type",
        "Other synthesis type",
        "Unclassified evidence synthesis" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition "Evidence synthesis types not captured by the specific categories of systematic review, umbrella review, narrative review, guideline, or health technology assessment." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Z_Other evidence synthesis type" .

<https://vocab.destiny-evidence.org/methods/DSNY000637> a skos:Concept ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000198> ;
    skos:definition """Advanced quantitative synthesis of existing studies conducted without systematic review methods for searching, selecting, and assessing evidence.
""" ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Meta-analysis (unsystematic)" ;
    skos:scopeNote "Typically distinguished from systematic reviews with meta-analyses because the statistical methods may be rigorous, but the evidence identification and selection process is not systematic or reproducible. Often occuring in Economics." .

<https://vocab.destiny-evidence.org/methods/DSNY000665> a skos:Concept ;
    skos:altLabel "Ethnographic methods",
        "Fieldwork",
        "Participant observation" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000541> ;
    skos:definition "Research defined by immersive fieldwork. This is prolonged engagement with a community or setting, participant observation, field notes, with interviews (if any) being informal and secondary to observation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Ethnographic" .

<https://vocab.destiny-evidence.org/methods/DSNY000666> a skos:Concept ;
    skos:altLabel "LSR",
        "Living evidence synthesis" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review that is continually or periodically updated as new evidence becomes available, rather than being conducted as a one-off snapshot. It follows standard systematic review methodology (pre-specified protocol, systematic search, and appraisal) but incorporates a defined process for regularly re-searching, re-screening, and re-synthesizing evidence to keep the review current over time." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Living systematic review" ;
    skos:scopeNote "There are different types of \"living systematic reviews\". E.g. for a \"Living evidence map\" use both labels \"Evidence map / evidence gap map\" and \"Living systematic review\"." .

<https://vocab.destiny-evidence.org/population-age/DSNY000248> a skos:Concept ;
    skos:altLabel "Across the life course",
        "All age groups",
        "Lifespan",
        "Total population" ;
    skos:definition "Studies or data that encompass individuals across all age groups without restriction, or where findings apply across the full life course." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "1. All ages" .

<https://vocab.destiny-evidence.org/population-age/DSNY000250> a skos:Concept ;
    skos:altLabel "First 28 days",
        "Neonatal period",
        "Neonate",
        "Newborn",
        "Newborn baby" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000249> ;
    skos:definition "Infants in the first 28 days of life, a critical period of physiological adaptation with high vulnerability to infection, thermal stress, and nutritional insufficiency." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "Newborn infant" .

<https://vocab.destiny-evidence.org/population-age/DSNY000252> a skos:Concept ;
    skos:altLabel "Early childhood",
        "Preschool children",
        "Toddlers",
        "Under 5s",
        "Young children" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000251> ;
    skos:definition "Children aged 2 to 5 years in the preschool developmental stage, characterised by rapid brain development, high activity levels, and reliance on caregivers for protection from environmental hazards." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "3.1. Preschool child (2-5 years)" .

<https://vocab.destiny-evidence.org/population-age/DSNY000253> a skos:Concept ;
    skos:altLabel "6 to 12 year olds",
        "Middle childhood",
        "Primary school age",
        "School children" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000251> ;
    skos:definition "Children aged 6 to 12 years in middle childhood, a period of continued physical growth, cognitive development, and increasing social independence." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "3.2. Child (6-12 years)" .

<https://vocab.destiny-evidence.org/population-age/DSNY000254> a skos:Concept ;
    skos:altLabel "Adolescence",
        "Teenagers",
        "Teens",
        "Young people",
        "Youth" ;
    skos:definition "Individuals aged 13 to 18 years undergoing puberty and adolescent development, with distinct biological vulnerabilities and behavioural risk profiles compared to younger children and adults." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "4. Adolescent (13-18 years)" .

<https://vocab.destiny-evidence.org/population-age/DSNY000256> a skos:Concept ;
    skos:altLabel "19 to 44 year olds",
        "Early adulthood",
        "Working age",
        "Young adults" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000255> ;
    skos:definition "Adults aged 19 to 44 years, typically characterised by peak physical capacity, reproductive activity, and workforce participation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "5.1. Adult (19-44 years)" .

<https://vocab.destiny-evidence.org/population-age/DSNY000257> a skos:Concept ;
    skos:altLabel "45 to 64 year olds",
        "Mid-life",
        "Middle age",
        "Middle-aged adults" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000255> ;
    skos:definition "Adults aged 45 to 64 years, a life stage associated with the onset of chronic non-communicable diseases and changing physiological risk profiles." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "5.2. Middle aged (45-64 years)" .

<https://vocab.destiny-evidence.org/population-age/DSNY000259> a skos:Concept ;
    skos:altLabel "65 to 78 year olds",
        "Early older age",
        "Young old",
        "Younger elderly" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000258> ;
    skos:definition "Older adults aged 65 to 78 years, often retaining significant functional capacity but with increasing chronic disease burden and growing vulnerability to environmental stressors." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "Aged (65-78 years)" .

<https://vocab.destiny-evidence.org/population-age/DSNY000260> a skos:Concept ;
    skos:altLabel "80 and over",
        "Octogenarians",
        "Oldest adults",
        "Oldest old",
        "Very old" ;
    skos:broader <https://vocab.destiny-evidence.org/population-age/DSNY000258> ;
    skos:definition "Individuals aged 80 years and older, the fastest-growing demographic in many populations, with the highest prevalence of frailty, multimorbidity, and vulnerability to adverse health events." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-age> ;
    skos:prefLabel "Aged (80 years and older)" .

<https://vocab.destiny-evidence.org/population-gender-sex/DSNY000244> a skos:Concept ;
    skos:altLabel "All sexes",
        "Both sexes",
        "Mixed gender",
        "Total population" ;
    skos:definition "Studies or data that include individuals of all gender identities or both sexes without stratification, or where findings apply across the full gender spectrum." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-gender-sex> ;
    skos:prefLabel "All genders" .

<https://vocab.destiny-evidence.org/population-gender-sex/DSNY000245> a skos:Concept ;
    skos:altLabel "Gender diverse",
        "Gender minority",
        "Gender non-conforming",
        "LGBTQ+",
        "Non-binary",
        "Transgender" ;
    skos:definition "Individuals whose gender identity or expression differs from the sex assigned at birth, including transgender, non-binary, and other gender-diverse people." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-gender-sex> ;
    skos:prefLabel "Diverse" .

<https://vocab.destiny-evidence.org/population-gender-sex/DSNY000246> a skos:Concept ;
    skos:altLabel "Female sex",
        "Females",
        "Girls",
        "Women",
        "Women and girls" ;
    skos:definition "Individuals identified as female by biological sex or gender identity, used to stratify health data or describe sex-specific biological and social health determinants." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-gender-sex> ;
    skos:prefLabel "Female" .

<https://vocab.destiny-evidence.org/population-gender-sex/DSNY000247> a skos:Concept ;
    skos:altLabel "Boys",
        "Male sex",
        "Males",
        "Men",
        "Men and boys" ;
    skos:definition "Individuals identified as male by biological sex or gender identity, used to stratify health data or describe sex-specific biological and social health determinants." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-gender-sex> ;
    skos:prefLabel "Male" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000233> a skos:Concept ;
    skos:altLabel "Chronic disease",
        "Chronic illness",
        "Comorbidities",
        "Long-term conditions",
        "Multimorbidity" ;
    skos:definition "Individuals living with one or more long-term physical health conditions that reduce physiological resilience and increase susceptibility to adverse health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Chronic conditions (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000234> a skos:Concept ;
    skos:altLabel "Disability",
        "Functionally impaired",
        "People with disabilities",
        "Physically disabled" ;
    skos:definition "Individuals with physical, sensory, cognitive, or mental impairments that limit daily functioning and may increase exposure to harm and reduce capacity to respond to environmental or social stressors." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Disabled (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000235> a skos:Concept ;
    skos:altLabel "BAME",
        "Ethnic minorities",
        "People of colour",
        "Racial minorities",
        "Racialised communities" ;
    skos:definition "Population groups defined by shared ethnic, cultural, or racial identity that may face structural disadvantage, discrimination, or disproportionate exposure to environmental and social risk factors." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Ethnic minorities (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000236> a skos:Concept ;
    skos:altLabel "Elderly frailty",
        "Frail elderly",
        "Frail older adults",
        "Frailty" ;
    skos:definition "Older adults with reduced physiological reserve and resilience, characterised by weakness, fatigue, and vulnerability to adverse health outcomes following minor stressors." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Frail elderly (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000237> a skos:Concept ;
    skos:altLabel "Aboriginal peoples",
        "First Nations",
        "Indigenous communities",
        "Native peoples",
        "Tribal communities" ;
    skos:definition "Populations with historical, cultural, and territorial ties to lands prior to colonisation, who often face compounded social, economic, and environmental vulnerabilities." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Indigenous peoples (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000238> a skos:Concept ;
    skos:altLabel "Babies",
        "Infants",
        "Neonates",
        "Paediatric population",
        "Young children" ;
    skos:definition "Young children and infants whose immature physiological systems, developmental dependency, and limited autonomy increase their susceptibility to environmental exposures and health harms." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Infants / children (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000239> a skos:Concept ;
    skos:altLabel "Deprived communities",
        "Economically disadvantaged",
        "Low income",
        "Poverty",
        "Socioeconomic deprivation" ;
    skos:definition "Individuals and households with insufficient financial resources to meet basic needs, facing compounded vulnerability through reduced access to healthcare, nutrition, safe housing, and adaptive capacity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Low-income (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000240> a skos:Concept ;
    skos:altLabel "Asylum seekers",
        "IDP",
        "Immigrants",
        "Internally displaced persons",
        "Migrants",
        "Refugees" ;
    skos:definition "People who have moved within or across borders, voluntarily or under duress, and who may face elevated health risks due to displacement, poor living conditions, and restricted access to services." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Migrants (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000241> a skos:Concept ;
    skos:altLabel "Agricultural workers",
        "Construction workers",
        "Occupational vulnerability",
        "Outdoor workers",
        "Workers" ;
    skos:definition "Individuals whose occupation exposes them to elevated health hazards, including outdoor workers in agriculture, construction, and other sectors with high physical exposure to environmental conditions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Occupation-based (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000242> a skos:Concept ;
    skos:altLabel "Antenatal",
        "Expectant mothers",
        "Gestational period",
        "Pregnant women",
        "Prenatal" ;
    skos:definition "Individuals during pregnancy, whose altered physiology and increased metabolic demands heighten susceptibility to environmental exposures and infectious disease with potential consequences for both maternal and foetal health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Pregnancy (Vulnerability)" .

<https://vocab.destiny-evidence.org/population-vulnerability/DSNY000243> a skos:Concept ;
    skos:altLabel "Female population",
        "Females",
        "Gender inequality",
        "Women's vulnerability" ;
    skos:definition "Women as a population group who may face heightened vulnerability due to biological factors, gender-based inequalities in resource access, and higher exposure to specific social and economic risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population-vulnerability> ;
    skos:prefLabel "Women (Vulnerability)" .

<https://vocab.destiny-evidence.org/publication-type/DSNY000625> a skos:Concept ;
    skos:definition "A registered or published research protocol or trials registry record describing a study that is planned or underway but has not yet reported results. " ;
    skos:inScheme <https://vocab.destiny-evidence.org/publication-type> ;
    skos:prefLabel "Planned research/protocol" ;
    skos:scopeNote "Trials registry record, protocol (published in a scientific journal as journal article or as another reference type)." .

<https://vocab.destiny-evidence.org/publication-type/DSNY000626> a skos:Concept ;
    skos:definition "A research manuscript that has been made publicly available prior to formal peer review and journal publication, such as those posted on medRxiv or SSRN." ;
    skos:inScheme <https://vocab.destiny-evidence.org/publication-type> ;
    skos:prefLabel "Preprint/working paper" .

<https://vocab.destiny-evidence.org/publication-type/DSNY000627> a skos:Concept ;
    skos:definition "A peer-reviewed research output published in an academic journal, including full research articles, letters to the editor, commentaries, and opinion pieces." ;
    skos:inScheme <https://vocab.destiny-evidence.org/publication-type> ;
    skos:prefLabel "Article (academic journal)" ;
    skos:scopeNote "Full publication, letter, comment, opinion, published in a scientific journal. Protocols, even though published as a journal article, are not classified into this concept, but under \"Planned research\"." .

<https://vocab.destiny-evidence.org/publication-type/DSNY000628> a skos:Concept ;
    skos:definition "Reports published outside the classic editorial route, predominantly by intergovernmental organizations, supra-national organizations, NGOs, governments." ;
    skos:inScheme <https://vocab.destiny-evidence.org/publication-type> ;
    skos:prefLabel "Grey literature" .

<https://vocab.destiny-evidence.org/publication-type/DSNY000629> a skos:Concept ;
    skos:inScheme <https://vocab.destiny-evidence.org/publication-type> ;
    skos:prefLabel "Z_Other reference type" ;
    skos:scopeNote "All records that do not fit into the other concepts in the \"reference type\" scheme." .

