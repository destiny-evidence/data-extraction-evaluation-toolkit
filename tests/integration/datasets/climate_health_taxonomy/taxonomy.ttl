        "Other infectious death" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000306> ;
    skos:definition "Deaths from infectious diseases not classified under respiratory, enteric, or vector-borne categories, including meningitis, encephalitis, and vaccine-preventable infections." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Other infectious diseases mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000311> a skos:Concept ;
    skos:altLabel "Neonatal death",
        "Newborn mortality",
        "Perinatal mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000305> ;
