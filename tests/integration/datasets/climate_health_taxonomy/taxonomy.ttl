    skos:prefLabel "1. Megacities" .

<https://vocab.destiny-evidence.org/human-settlements/DSNY000510> a skos:Concept ;
    skos:altLabel "Peri-urban areas",
        "Rural-urban interface",
        "Suburban fringe",
        "Urban fringe",
        "Urban periphery",
        "Urban-rural fringe" ;
    skos:definition "Areas at the urban-rural interface characterised by mixed land use, rapid demographic and physical change, and often partial or transitional access to urban services. The term is used variably across research traditions to describe either the rural-urban fringe of a growing city or areas that are administratively rural but functionally urban." ;
    skos:inScheme <https://vocab.destiny-evidence.org/human-settlements> ;
    skos:prefLabel "2. Peri-urban settlements" .

<https://vocab.destiny-evidence.org/human-settlements/DSNY000511> a skos:Concept ;
    skos:altLabel "Favelas",
        "Shack settlements",
        "Shanty towns",
        "Slums",
        "Squatter settlements",
        "Unauthorised settlements",
        "Unplanned settlements",
        "Unregulated settlements",
        "Urban informality" ;
    skos:definition "Residential areas characterised by lack of secure land tenure, inadequate infrastructure, poor access to basic services such as water, sanitation, and healthcare, and overcrowding. This category is intentionally broad, encompassing the diverse forms of unplanned or unauthorised settlement that develop on the periphery of formal cities, without relying on contested administrative labels that vary by country." ;
    skos:inScheme <https://vocab.destiny-evidence.org/human-settlements> ;
    skos:prefLabel "3. Informal settlements" .

<https://vocab.destiny-evidence.org/human-settlements/DSNY000513> a skos:Concept ;
    skos:altLabel "Asylum settlements",
        "Displaced person settlements",
        "Forced displacement settlements",
        "Humanitarian settlements",
        "IDP camps",
        "Internally displaced settlements",
        "Refugee camps" ;
    skos:definition "Settlements established to house populations forcibly displaced by conflict, persecution, or disaster, including formal refugee camps, informal displaced person settlements, and spontaneous settlements in host communities. Distinct from other informal settlements in their governance structures, legal frameworks, humanitarian actors, and policy context, and complementary to concepts of forced displacement and migration by capturing the physical and administrative character of where displaced people live rather than the movement itself." ;
    skos:inScheme <https://vocab.destiny-evidence.org/human-settlements> ;
    skos:prefLabel "4. Refugee/displaced settlements" .

<https://vocab.destiny-evidence.org/human-settlements/DSNY000640> a skos:Concept ;
    skos:altLabel "Countryside communities",
        "Peripheral settlements",
        "Remote settlements",
        "Rural localities",
        "Small settlements",
        "Village settlements" ;
    skos:definition "Communities located outside urban areas, typically characterised by low population density, dispersed populations, and greater reliance on agriculture, natural resources, or small local economies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/human-settlements> ;
    skos:prefLabel "5. Rural settlements" ;
    skos:scopeNote "Also captures remote settlements, which are communities located at substantial distance from major population centres, services, and infrastructure, often characterised by geographic isolation, limited accessibility, and reduced access to healthcare, education, and other essential services." .

<https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000088> a skos:Concept ;
    skos:altLabel "Climate accords",
        "International agreements",
        "Treaties" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-responses-solutions/DSNY000087> ;
