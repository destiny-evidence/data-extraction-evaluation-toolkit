<https://vocab.destiny-evidence.org/health-outcomes/DSNY000312> a skos:Concept ;
    skos:altLabel "Maternal death",
        "Obstetric mortality",
        "Pregnancy-related mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000305> ;
    skos:definition "Deaths among women during pregnancy, childbirth, or the postpartum period attributable to obstetric causes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
