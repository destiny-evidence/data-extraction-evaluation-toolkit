    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Military (Sector)" .

<https://vocab.destiny-evidence.org/topic/DSNY000054> a skos:Concept ;
    skos:altLabel "Causal attribution",
        "Climate attribution",
        "Event attribution" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000053> ;
    skos:definition "The process of establishing the causal contribution of climate change to observed changes in physical, ecological, or human systems, including specific extreme weather events or health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Attribution" ;
    skos:scopeNote "Refers to attribution as a high-level thematic area of climate research, encompassing the field of climate and health attribution broadly. Distinct from 'Attribution' in the Methods scheme, which classifies attribution as a specific study aim within primary research." .

<https://vocab.destiny-evidence.org/topic/DSNY000490> a skos:Concept ;
    skos:altLabel "Adaptive failure",
        "Counterproductive adaptation",
        "Failed adaptation",
        "Mal-adaptation",
        "Maladaptive action",
        "Negative adaptation outcomes",
        "Unintended adaptation consequences" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000052> ;
    skos:definition "Adaptation actions that inadvertently increase vulnerability or exposure to harm, reduce adaptive capacity, or create new risks for human or natural systems, often as an unintended consequence of well-intentioned interventions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Maladaptation" .

<https://vocab.destiny-evidence.org/topic/DSNY000491> a skos:Concept ;
    skos:altLabel "Ancillary benefits",
        "Co-benefits of mitigation",
        "Health co-benefits",
        "Mitigation co-benefits",
        "Side benefits",
        "Triple wins" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000051> ;
    skos:definition "Positive health, social, or environmental benefits arising from mitigation actions that are additional to the primary goal of reducing greenhouse gas emissions, such as improved air quality or increased physical activity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Co-Benefits" .

<https://vocab.destiny-evidence.org/topic/DSNY000492> a skos:Concept ;
    skos:altLabel "Climate-related losses",
        "Irreversible impacts",
        "L&D",
        "NELD",
        "Non-economic loss and damage",
        "Residual impact",
        "Unavoidable impacts" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000053> ;
    skos:definition "Negative consequences of climate change that cannot be avoided through mitigation or adaptation, including irreversible harm to lives, livelihoods, cultural heritage, ecosystems, and infrastructure." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Loss and damage" .

<https://vocab.destiny-evidence.org/topic/DSNY000493> a skos:Concept ;
    skos:altLabel "Anticipated impact",
        "Climate projections",
        "Future climate impact",
        "Future risk",
        "Projected climate effects",
        "Projected impact",
        "Scenario-based impact" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000053> ;
    skos:definition "Projected effects on human health, ecosystems, and societies arising from anticipated changes in climate over coming decades, typically derived from climate modelling and scenario analysis." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Future impact" .

<https://vocab.destiny-evidence.org/topic/DSNY000638> a skos:Concept ;
    skos:altLabel "Ability to recover",
        "Adaptive capacity",
        "Bounce-back capability",
        "Climate-readiness",
        "Coping capacity",
        "Robustness",
        "Transformative capacity" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000052> ;
    skos:definition "The capacity of individuals, communities, ecosystems, or systems to anticipate, withstand, recover from, and adapt to climate-related shocks and stresses. It is generally considered an adaptation outcome or objective." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Resilience" .

<https://vocab.destiny-evidence.org/topic/DSNY000639> a skos:Concept ;
    skos:altLabel "Adaptation strategy",
        "Anticipatory action",
        "Disaster preparedness",
        "Emergency preparedness",
        "Emergency response plans",
        "Readiness",
        "Risk preparedness",
        "Warning systems" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000052> ;
    skos:definition "Planning, developing capacities, and implementing measures in advance to enable effective responses to climate-related events and reduce their impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Preparedness" .

evrepo:LinkedDataEnhancement a owl:Class ;
    rdfs:label "Linked Data Enhancement" ;
    dct:description "A structured linked-data annotation attached to a Reference in the repository. Contains one or more Investigations." .

<https://vocab.destiny-evidence.org/topic/DSNY000051> a skos:Concept ;
    skos:altLabel "Climate mitigation",
        "Emissions reduction",
        "GHG mitigation",
        "GHG reduction" ;
    skos:definition "Actions and strategies aimed at reducing or preventing greenhouse gas emissions in order to limit the magnitude of future climate change and its associated health and environmental impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:narrower <https://vocab.destiny-evidence.org/topic/DSNY000491> ;
    skos:prefLabel "Mitigation" ;
    skos:scopeNote "Assign when the study concerns greenhouse-gas emissions or fossil fuels — either (a) actions or strategies to reduce them (e.g. food-system, agricultural, transport, energy, or industrial measures that cut emissions), or (b) cases where emissions or fossil fuels are the source of the health or environmental harm being studied (e.g. health effects of coal power-plant emissions or fossil-fuel combustion), since these imply potential mitigation actions. The study need not itself describe a mitigation action, and need not use the word 'mitigation'." .

evrepo:Investigation a owl:Class ;
    rdfs:label "Investigation" ;
    dct:description "A study reported within a Reference. An Investigation produces one or more Findings." .

<https://vocab.destiny-evidence.org/climate-factors-fossil-fuels> a skos:ConceptScheme ;
    dct:description "Carbon-based energy sources formed from ancient organic matter, whose combustion is the dominant source of anthropogenic greenhouse gas emissions and a major driver of air pollution and associated health burdens." ;
    dct:title "Climate factors - Fossil fuels" ;
    skos:hasTopConcept <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000619>,
        <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000620>,
        <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000621>,
        <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000622> .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000296> a skos:Concept ;
    skos:altLabel "Death",
        "Fatal outcomes",
        "Mortality outcomes" ;
    skos:definition "The occurrence of death as a health outcome, classified by cause, age group, and population to characterise the fatal burden of disease." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:narrower <https://vocab.destiny-evidence.org/health-outcomes/DSNY000297>,
        <https://vocab.destiny-evidence.org/health-outcomes/DSNY000298>,
        <https://vocab.destiny-evidence.org/health-outcomes/DSNY000305> ;
    skos:prefLabel "1. Mortality (Outcome)" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000470> a skos:Concept ;
    skos:altLabel "Harm",
        "Physical injury",
        "Trauma",
        "Wounds" ;
    skos:definition "Physical harm to the body resulting from external causes, including unintentional injuries, self-harm, interpersonal violence, and conflict." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:narrower <https://vocab.destiny-evidence.org/health-outcomes/DSNY000471>,
        <https://vocab.destiny-evidence.org/health-outcomes/DSNY000472>,
        <https://vocab.destiny-evidence.org/health-outcomes/DSNY000485> ;
    skos:prefLabel "4. Injuries" ;
    skos:scopeNote "GBD ref: 687" .

<https://vocab.destiny-evidence.org/topic/DSNY000052> a skos:Concept ;
    skos:altLabel "Adaptation action",
        "Adaptive capacity",
        "Adaptive response",
        "Climate adaptation",
        "Climate adjustment",
        "Coping capacity",
        "Preparedness",
        "Resilience",
        "Vulnerability reduction" ;
    skos:definition "Adjustments in natural or human systems in response to actual or anticipated climate change, intended to moderate harm or exploit beneficial opportunities arising from climate variability." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:narrower <https://vocab.destiny-evidence.org/topic/DSNY000490>,
        <https://vocab.destiny-evidence.org/topic/DSNY000638>,
        <https://vocab.destiny-evidence.org/topic/DSNY000639> ;
    skos:prefLabel "Adaptation" ;
    skos:scopeNote "Assign when the study concerns adjusting to, managing, forecasting, monitoring, or coping with climate variables or climate-related extreme events — including early-warning or prediction systems, risk management, and infrastructural or agricultural measures (e.g. irrigation optimisation for water stress, flood modelling for planning, disaster preparedness). The paper need not frame these explicitly as responses to 'climate change'. Resilience is the capacity of individuals, communities, ecosystems, or systems to anticipate, withstand, recover from, and adapt to climate-related shocks and stresses. It is generally considered an adaptation outcome or objective." .

<https://vocab.destiny-evidence.org/topic/DSNY000053> a skos:Concept ;
    skos:altLabel "Climate consequences",
        "Climate effects",
        "Climate impact",
        "Effects of climate change" ;
    skos:definition "The effects of climate change on natural and human systems, including consequences for health, ecosystems, economies, and societies resulting from climate variability and change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:narrower <https://vocab.destiny-evidence.org/topic/DSNY000054>,
        <https://vocab.destiny-evidence.org/topic/DSNY000492>,
        <https://vocab.destiny-evidence.org/topic/DSNY000493> ;
    skos:prefLabel "Impact" ;
    skos:scopeNote "Assign when the study characterises, measures, models, or reviews the effects, harms, hazards, or risks arising from a climate variable (e.g. changes in temperature, precipitation, humidity, sea level, or wind) or a climate-related extreme event (e.g. heatwave, flood, drought, storm, wildfire, extreme cold) on human health, ecosystems, economies, or societies. This includes cases where a climate variable or extreme event modifies exposure to another hazard (e.g. temperature or drought altering air-pollution, wildfire-smoke, or infectious-disease exposure). Do not assign for the health effects of a non-climate exposure on its own (e.g. air pollution or chemicals with no climatic driver in the causal pathway). The paper need not use the words 'climate change' — the presence of a climate variable or extreme climate-related event as the driver is what matters." .

<https://vocab.destiny-evidence.org/methods/DSNY000198> a skos:Concept ;
    skos:altLabel "Research synthesis",
        "Review",
        "Secondary research" ;
    skos:definition "Research whose own design is a review or synthesis of existing studies or literature rather than the collection of new primary data — spanning systematic reviews and their variants (scoping, rapid, realist, umbrella, living, qualitative, mixed-methods), narrative reviews, meta-analyses, evidence and gap maps, health technology assessments, and clinical or public-health guidelines." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:narrower <https://vocab.destiny-evidence.org/methods/DSNY000201>,
        <https://vocab.destiny-evidence.org/methods/DSNY000206>,
        <https://vocab.destiny-evidence.org/methods/DSNY000207>,
        <https://vocab.destiny-evidence.org/methods/DSNY000208>,
        <https://vocab.destiny-evidence.org/methods/DSNY000555>,
        <https://vocab.destiny-evidence.org/methods/DSNY000637> ;
    skos:prefLabel "2. Evidence synthesis" ;
    skos:scopeNote "Assign when the study is itself a review or synthesis of prior work — it aggregates, reviews, maps, or synthesises findings, publications, or evidence from existing studies or literature. This includes narrative and non-systematic reviews, scoping and mapping exercises, bibliometric or publication analyses, meta-analyses, guidelines, and health technology assessments; a formal systematic method is NOT required. Do not assign to a primary study merely because it cites or discusses prior literature — assign only when reviewing or synthesising existing evidence is the study's own design or output." .

