@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://vocab.destiny-evidence.org/actors/DSNY000162> a skos:Concept ;
    skos:altLabel "Intergovernmental bodies",
        "Multilateral organisations",
        "UN agencies" ;
    skos:definition "Supranational bodies including United Nations agencies, multilateral development banks, and intergovernmental organisations that coordinate policy, financing, and action across nations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "1. Supranational and international organizations (Actor)" .

<https://vocab.destiny-evidence.org/actors/DSNY000163> a skos:Concept ;
    skos:altLabel "Governments",
        "Public authorities",
        "State" ;
    skos:definition "National, regional, and local government bodies responsible for setting policy, enacting legislation, and implementing programmes within their jurisdictions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "2. Governments (Actor)" .

<https://vocab.destiny-evidence.org/actors/DSNY000164> a skos:Concept ;
    skos:altLabel "Business",
        "Commercial organizations",
        "Corporations",
        "Enterprises",
        "Industry" ;
    skos:definition "Commercial enterprises, industries, and business associations whose operations, investments, and innovations shape economic and environmental outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "3. Private sector (Actor)" .

<https://vocab.destiny-evidence.org/actors/DSNY000165> a skos:Concept ;
    skos:altLabel "Community organisations",
        "NGOs",
        "Non-governmental organisations" ;
    skos:definition "Non-profit organisations, advocacy groups, and community-based organisations that represent public interests, support communities, and hold governments and businesses accountable." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "4. Civil society (Actor)" .

<https://vocab.destiny-evidence.org/actors/DSNY000166> a skos:Concept ;
    skos:altLabel "Citizens",
        "Domestic unit",
        "Family",
        "Household",
        "Individuals" ;
    skos:definition "Individual people and domestic units whose everyday choices, behaviours, and circumstances make them both agents of and subjects of wider social and environmental change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "5. Households / individuals (Actor)" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000595> a skos:Concept ;
    skos:altLabel "Atmospheric warming",
        "Climate breakdown",
        "Climate crisis",
        "Climate disruption",
        "Climate emergency",
        "Earth warming",
        "General climate change",
        "Global heating",
        "Global warming",
        "Planetary warming",
        "Rising global temperatures",
        "Unspecified climate change" ;
    skos:definition "Climate change where the specific driver or mechanism is not identified or distinguished, used when studies refer to climate change in general terms." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "(Unspecified) climate change" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000596> a skos:Concept ;
    skos:altLabel "Unspecified weather change",
        "Weather variability" ;
    skos:definition "General changes in weather patterns not attributed to a specific meteorological variable, used when studies refer to weather variability in broad terms." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "(Unspecified) changes in weather" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000597> a skos:Concept ;
    skos:altLabel "Cryosphere change",
        "Glacier melt",
        "Snowmelt" ;
    skos:definition "Accelerated melting of glaciers and snowpack due to rising temperatures, affecting freshwater supply, sea levels, and downstream ecosystems." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in glacier / snow melt" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000598> a skos:Concept ;
    skos:altLabel "Atmospheric moisture change",
        "Humidity change" ;
    skos:definition "Shifts in atmospheric moisture levels that affect thermal comfort, respiratory health, and the prevalence of moisture-related diseases." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in humidity" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000599> a skos:Concept ;
    skos:altLabel "Changes in rainfall",
        "Precipitation variability",
        "Rainfall change" ;
    skos:definition "Alterations in the amount, timing, or intensity of rainfall and snowfall, affecting water availability, flood risk, and drought conditions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in precipitation" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000600> a skos:Concept ;
    skos:altLabel "Coastal inundation",
        "Ocean level rise",
        "Sea level change" ;
    skos:definition "The increase in mean sea level resulting from thermal expansion of seawater and melting ice, threatening coastal communities, infrastructure, and freshwater resources." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in sea level" ;
    skos:scopeNote "Main drivers: Thermal expansion of oceans, melting glaciers/ice sheets, ocean circulation changes." .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000601> a skos:Concept ;
    skos:altLabel "Phenological change",
        "Season length change",
        "Seasonal shift" ;
    skos:definition "Shifts in the duration of seasons, including earlier spring onset and extended summers, with consequences for agriculture, vector biology, and human health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in season length" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000602> a skos:Concept ;
    skos:altLabel "Temperature change",
        "Temperature shift",
        "Warming" ;
    skos:definition "Long-term shifts in average or extreme temperature conditions, including warming trends, that affect human health, ecosystems, and society." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in temperature" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000603> a skos:Concept ;
    skos:altLabel "Wind pattern change",
        "Wind variability" ;
    skos:definition "Alterations in wind patterns and velocity that can affect air quality, energy systems, and the spread of airborne pathogens and pollutants." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in wind speed" .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000623> a skos:Concept ;
    skos:altLabel "Cimate trends",
        "Climate alteration",
        "Climate anomalies",
        "Climate fluctuations",
        "Climate instability",
        "Climate shifts",
        "Climate variation",
        "Climatic oscillations",
        "Climatic variation",
        "El Niño ((Southern Oscillation/ENSO)",
        "La Niña",
        "North Atlantic Oscillation" ;
    skos:definition "Climate variability refers to fluctuations in climate conditions (temperature, precipitation, wind patterns, etc.) over months, years, or decades around a longer-term average. Climate variability is influenced by multiple climate drivers." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Climate variability" ;
    skos:scopeNote "Refers to variations in the mean state and other climate statistics (standard deviations, the occurrence of extremes, etc.) on all temporal and spatial scales beyond those of individual weather events." .

<https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability/DSNY000632> a skos:Concept ;
    skos:altLabel "Changes in freshwater systems",
        "Changes in inland hydrology",
        "Freshwater systems change" ;
    skos:definition "Climate-driven changes in freshwater systems, including altered lake and river levels, reduced or increased water availability, and changes in hydrological patterns that affect ecosystems, livelihoods, and human health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-drivers-variability> ;
    skos:prefLabel "Changes in inland water bodies" ;
    skos:scopeNote "E.g. declining water levels in Lake Chad Basin, shrinking lakes, changing river flows. Main drivers: Changes in precipitation, evaporation, drought, water withdrawals, watershed changes, land-use change." .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000611> a skos:Concept ;
    skos:altLabel "GHGs",
        "Heat-trapping gases",
        "Unspecified greenhouse gases" ;
    skos:definition "Atmospheric gases that trap heat and contribute to the greenhouse effect, referred to collectively without specifying the individual gas type." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "(Unspecified) greenhouse gases" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000612> a skos:Concept ;
    skos:altLabel "CO2",
        "Carbon dioxide emissions" ;
    skos:definition "The primary long-lived greenhouse gas produced by fossil fuel combustion, deforestation, and industrial processes, responsible for the majority of anthropogenic radiative forcing." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Carbon dioxide (CO₂)" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000613> a skos:Concept ;
    skos:altLabel "Aerosols",
        "Black carbon",
        "Fine particles",
        "PM10",
        "PM2.5",
        "Particulate air pollution" ;
    skos:definition "Airborne particles of 10 or 2.5 micrometres or less in diameter. Fine particulate matter can include components such as black carbon and sulfate aerosols, that affect both climate and human health through respiratory and cardiovascular pathways." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Particulate matter (PM10) / fine particulate matter (PM2.5) / black/organic carbon / sulfate/nitrate aerosols" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000614> a skos:Concept ;
    skos:altLabel "F-gases",
        "HFCs",
        "NF3",
        "PFCs",
        "SF6",
        "Synthetic greenhouse gases" ;
    skos:definition "A group of potent synthetic greenhouse gases used in industrial applications, refrigeration, and electronics manufacturing, with very high global warming potentials and long atmospheric lifetimes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Fluorinated gases / hydrofluorocarbons / perfluorocarbons / sulfur hexafluoride / nitrogen trifluoride" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000615> a skos:Concept ;
    skos:altLabel "CH4",
        "Methane emissions",
        "Natural gas emissions" ;
    skos:definition "A potent short-lived greenhouse gas emitted from livestock, rice cultivation, landfills, and fossil fuel extraction, with a global warming potential far exceeding that of CO₂ over 20 years." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Methane (CH₄)" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000616> a skos:Concept ;
    skos:altLabel "Agricultural greenhouse gas",
        "N2O",
        "Nitrous oxide emissions" ;
    skos:definition "A greenhouse gas and ozone-depleting substance emitted primarily from agricultural soils, livestock, and nitrogen fertilisers, with a high global warming potential." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Nitrous oxide (N₂O)" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000617> a skos:Concept ;
    skos:altLabel "CFCs",
        "HCFCs",
        "Halons",
        "ODSs",
        "Ozone-depleting chemicals" ;
    skos:definition "Chemical compounds that destroy stratospheric ozone and act as potent greenhouse gases, regulated under the Montreal Protocol due to their combined climate and health impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Ozone-depleting substances / chlorofluorocarbons / hydrochlorofluorocarbons / halons / carbon tetrachloride / methyl chloroform" .

<https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents/DSNY000618> a skos:Concept ;
    skos:altLabel "Ground-level ozone",
        "O3",
        "Ozone pollution" ;
    skos:definition "A short-lived climate pollutant and air quality hazard formed by photochemical reactions between nitrogen oxides and volatile organic compounds, harmful to respiratory health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-climate-forcing-agents> ;
    skos:prefLabel "Tropospheric ozone (O₃)" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000604> a skos:Concept ;
    skos:altLabel "General climate extremes",
        "Unspecified extreme weather" ;
    skos:definition "Extreme weather events where the specific type is not identified, used when studies refer to climate extremes without distinguishing between event types." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Z_(Unspecified) extreme weather events" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000605> a skos:Concept ;
    skos:altLabel "Arid conditions",
        "Drought conditions" ;
    skos:definition "Prolonged periods of water deficit, often driven by abnormally low rainfall and/or increased evapotranspiration, resulting in reduced soil moisture and water availability, with consequences including crop and livestock losses, increased wildfire risk, and impacts on human health, nutrition, and livelihoods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Droughts" ;
    skos:scopeNote "Needs to be differentiated from \"Water quality and quantity\" as a health exposure (here: \"Health - Exposure\" > \"Water quality and quantity\")" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000606> a skos:Concept ;
    skos:altLabel "Cold snaps",
        "Cold spells",
        "Cold waves",
        "Freezing events" ;
    skos:definition "Episodes of abnormally low temperatures, including cold snaps and blizzards, associated with increased risk of hypothermia, cardiovascular events, and respiratory illness." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Extreme cold" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000607> a skos:Concept ;
    skos:altLabel "Heat events",
        "Heat waves",
        "Heatwaves",
        "High temperature extremes" ;
    skos:definition "Periods of abnormally high temperatures, including heatwaves, that pose direct health risks such as heat exhaustion, heat stroke, and excess mortality." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Extreme heat" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000608> a skos:Concept ;
    skos:altLabel "Flash floods",
        "Flooding",
        "Inundation" ;
    skos:definition "Temporary inundation of normally dry land caused by excessive rainfall, river overflow, storm surges, coastal flooding, rapid snowmelt, or other hydrological processes, including riverine, pluvial, coastal, and flash floods, with direct and indirect consequences for human health, displacement, infrastructure, livelihoods, and ecosystems." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Floods" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000609> a skos:Concept ;
    skos:altLabel "Cyclones",
        "Hailstorms",
        "Hurricanes",
        "Thunderstorms",
        "Tornadoes",
        "Tropical cyclones",
        "Typhoons" ;
    skos:definition "Intense meteorological events including tropical cyclones, hurricanes, typhoons, and severe thunderstorms or hailstorms, causing damage, flooding, and displacement." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Storms and severe wind" ;
    skos:scopeNote "Do not use for sand storms or dust storms, which are a distinct concept in this scheme (\"Sand and dust storms\")." .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000610> a skos:Concept ;
    skos:altLabel "Bushfires",
        "Forest fires",
        "Landscape fires" ;
    skos:definition "Uncontrolled fires in natural vegetation, increasingly associated with drought and heat, producing smoke and air pollution with severe respiratory and cardiovascular health impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Wildfires" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000633> a skos:Concept ;
    skos:altLabel "Extreme precipitation events",
        "Heavy rainfall" ;
    skos:definition "Unusually intense or prolonged episodes of rainfall, snowfall, or other precipitation that exceed typical conditions and can cause flooding, water-related hazards, disruption of essential services, and adverse impacts on human health, ecosystems, and livelihoods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Extreme precipitation" .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000634> a skos:Concept ;
    skos:altLabel "Blizzards",
        "Extreme icing",
        "Freezing rain",
        "Heavy snowfall",
        "Ice storms" ;
    skos:definition "Severe or unusual snow and ice conditions, including heavy snowfall, blizzards, freezing rain, and ice storms, that disrupt normal activities and can result in infrastructure damage, transport disruption, injuries, and adverse impacts on human health, ecosystems, and livelihoods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Extreme snow/ice events" ;
    skos:scopeNote "Driven by cold temperatures and frozen precipitation." .

<https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events/DSNY000635> a skos:Concept ;
    skos:altLabel "Dust aerosol events",
        "Dust events",
        "Sand storms",
        "Sandstorms" ;
    skos:definition "Wind-driven events that mobilize and transport airborne sand and dust particles, reducing air quality and visibility and posing risks to human health, ecosystems, infrastructure, and livelihoods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-extreme-weather-events> ;
    skos:prefLabel "Sand and dust storms" .

<https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000619> a skos:Concept ;
    skos:altLabel "Carbon fuels",
        "General fossil fuels",
        "Unspecified fossil fuels",
        "carbon-based fuels",
        "conventional fuels",
        "fossil energy sources",
        "mineral fuels",
        "solid fuels" ;
    skos:definition "Fossil fuel use or combustion where the specific fuel type is not identified, used when studies refer to fossil fuels in general without distinguishing between coal, oil, or gas." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels> ;
    skos:prefLabel "(Unspecified) fossil fuels" .

<https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000620> a skos:Concept ;
    skos:altLabel "Brown coal",
        "Hard coal",
        "Lignite" ;
    skos:definition "A solid fossil fuel formed from ancient plant matter, the most carbon-intensive energy source and a major contributor to greenhouse gas emissions and air pollution." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels> ;
    skos:prefLabel "Coal" .

<https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000621> a skos:Concept ;
    skos:altLabel "CNG",
        "Gas",
        "LNG",
        "Methane gas",
        "fracking gas",
        "fuel gas" ;
    skos:definition "A fossil fuel composed primarily of methane, used for heating, electricity generation, and industrial processes, with lower CO₂ emissions than coal but significant methane leakage risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels> ;
    skos:prefLabel "Natural gas" .

<https://vocab.destiny-evidence.org/climate-factors-fossil-fuels/DSNY000622> a skos:Concept ;
    skos:altLabel "Crude oil",
        "Petrol",
        "Petroleum",
        "diesel",
        "gasoline",
        "kerosene" ;
    skos:definition "A liquid fossil fuel refined into petroleum products including petrol, diesel, and jet fuel, a major source of greenhouse gas emissions from transport and industry." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factors-fossil-fuels> ;
    skos:prefLabel "Oil" .

<https://vocab.destiny-evidence.org/climate-zones/DSNY000651> a skos:Concept ;
    skos:altLabel "Arid region",
        "Dry region",
        "Dryland",
        "Semi-arid",
        "Semi-arid region",
        "Shrubland",
        "Steppe" ;
    skos:definition "Climates where precipitation is insufficient to meet evaporative demand, resulting in limited vegetation and frequent water scarcity. These climates are defined primarily by low rainfall rather than temperature." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-zones> ;
    skos:prefLabel "Dry / arid" ;
    skos:scopeNote "Defined by low precipitation relative to evaporation rather than temperature. Split into arid (desert) and semi-arid (steppe) subtypes; can occur in both hot and cold regions." .

<https://vocab.destiny-evidence.org/climate-zones/DSNY000652> a skos:Concept ;
    skos:altLabel "Equatorial",
        "Tropical zone",
        "Tropics" ;
    skos:definition "Climates found primarily near the equator, characterised by consistently high temperatures throughout the year and generally high humidity. Seasonal variation is usually driven by differences in rainfall rather than temperature, with many regions experiencing distinct wet and dry seasons." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-zones> ;
    skos:prefLabel "Tropical" ;
    skos:scopeNote "No winter; every month averages above 18°C. Characterized by high, fairly constant temperatures year-round, with rainfall patterns (constant, monsoonal, or seasonal/savanna) distinguishing the subtypes." .

<https://vocab.destiny-evidence.org/climate-zones/DSNY000653> a skos:Concept ;
    skos:altLabel "Humid subtropical",
        "Mediterranean",
        "Mid-latitude",
        "Oceanic",
        "Temperate climate",
        "Temperate zone" ;
    skos:definition "Moderate mid-latitude climates with relatively mild temperatures and distinct seasonal changes. These areas generally experience sufficient precipitation to support forests, agriculture, and diverse ecosystems." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-zones> ;
    skos:prefLabel "Temperate" ;
    skos:scopeNote "Mild winters and warm-to-hot summers, with at least one month averaging below 18°C but above −3°C. Includes Mediterranean, humid subtropical, and oceanic subtypes." .

<https://vocab.destiny-evidence.org/climate-zones/DSNY000654> a skos:Concept ;
    skos:altLabel "Antarctic",
        "Arctic",
        "Ice-cap",
        "Polar region",
        "Tundra" ;
    skos:definition "Cold climates where temperatures remain low throughout the year, with limited precipitation and short growing seasons. These regions are strongly influenced by latitude, ice cover, and low solar radiation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-zones> ;
    skos:prefLabel "Polar" ;
    skos:scopeNote "Every month averages below 10°C. Includes tundra (short, cool summers) and ice-cap (perpetual freezing) subtypes." .

<https://vocab.destiny-evidence.org/climate-zones/DSNY000658> a skos:Concept ;
    skos:altLabel "Boreal" ;
    skos:definition "Mid- and high-latitude climates characterised by large seasonal temperature differences, with warm summers and cold winters. Seasonal contrasts are often stronger inland due to reduced ocean influence." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-zones> ;
    skos:prefLabel "Continental" ;
    skos:scopeNote "Significant seasonal temperature swings, with warm-to-hot summers and cold winters (coldest month averaging below −3°C). Typically found in the interiors of large landmasses in the Northern Hemisphere; includes what's often called \"boreal\" climate at its colder extreme." .

<https://vocab.destiny-evidence.org/country-income/DSNY000136> a skos:Concept ;
    skos:altLabel "LIC",
        "Least developed countries",
        "Low-income countries" ;
    skos:definition "Countries classified by the World Bank as having the lowest gross national income per capita, typically facing the greatest climate vulnerability and least adaptive capacity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income> ;
    skos:prefLabel "Low" .

<https://vocab.destiny-evidence.org/country-income/DSNY000137> a skos:Concept ;
    skos:altLabel "Developing countries",
        "LMIC",
        "Lower-middle income countries" ;
    skos:definition "Countries classified by the World Bank in the lower-middle income tier, often experiencing rapid development while remaining highly vulnerable to climate-related health and economic impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income> ;
    skos:prefLabel "Lower middle" .

<https://vocab.destiny-evidence.org/country-income/DSNY000138> a skos:Concept ;
    skos:altLabel "Emerging economies",
        "UMIC",
        "Upper-middle income countries" ;
    skos:definition "Countries classified by the World Bank in the upper-middle income tier, with growing capacity for climate adaptation and mitigation but still facing significant climate risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income> ;
    skos:prefLabel "Upper middle" .

<https://vocab.destiny-evidence.org/country-income/DSNY000139> a skos:Concept ;
    skos:altLabel "Developed countries",
        "HIC",
        "High-income countries" ;
    skos:definition "Countries classified by the World Bank as having the highest gross national income per capita, generally with the greatest adaptive capacity but also the highest historical contributions to cumulative emissions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income> ;
    skos:prefLabel "High" .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000142> a skos:Concept ;
    skos:altLabel "Arid landscape",
        "Arid region",
        "Dryland" ;
    skos:definition "Very low precipitation; sparse, drought-adapted vegetation; can be hot or cold." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Desert (arid/semi-arid)" ;
    skos:scopeNote "Arid landscapes receiving very low annual precipitation, characterised by sparse vegetation and high temperatures, making them particularly vulnerable to heat stress and water scarcity." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000143> a skos:Concept ;
    skos:altLabel "Boreal forest",
        "Temperate forest",
        "Woodland" ;
    skos:definition "Moderate climate with four seasons; deciduous or mixed forest, moderate rainfall." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Temperate forest" ;
    skos:scopeNote "Land covered predominantly by trees and associated flora, providing critical ecosystem services including carbon sequestration, biodiversity habitat, and water regulation, all threatened by climate change." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000145> a skos:Concept ;
    skos:altLabel "Meadow",
        "Prairie",
        "Savanna" ;
    skos:definition "Warm regions with distinct wet and dry seasons; grass-dominated with scattered trees." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Tropical grassland / savanna" ;
    skos:scopeNote "Open landscapes dominated by grasses and low vegetation, sensitive to changes in precipitation and temperature, and at increased risk of drought and wildfire under climate change." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000146> a skos:Concept ;
    skos:altLabel "Archipelago",
        "Island state",
        "Small island" ;
    skos:definition "Land masses surrounded by water, particularly small island developing states, which face existential threats from sea level rise, coastal erosion, and increased storm intensity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Island" .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000147> a skos:Concept ;
    skos:altLabel "Alpine",
        "Highland",
        "Upland" ;
    skos:definition "Defined by elevation rather than latitude; conditions and vegetation shift with altitude, often ending in treeless alpine zones." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Mountain (alpine)" ;
    skos:scopeNote "Elevated terrain characterised by steep slopes and cooler temperatures, where glacier retreat, altered precipitation patterns, and biodiversity shifts are prominent climate change impacts." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000148> a skos:Concept ;
    skos:altLabel "Marine ecosystems",
        "Saltwater biome" ;
    skos:definition "Land saturated with water seasonally or permanently (marshes, swamps, bogs); high productivity and carbon storage." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Ocean / marine" .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000151> a skos:Concept ;
    skos:altLabel "Floodplain valley",
        "Lowland valley",
        "River valley" ;
    skos:definition "Low-lying areas between hills or mountains, often fertile and densely settled, which can be highly exposed to flooding and temperature extremes under climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Valley" .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000154> a skos:Concept ;
    skos:altLabel "Bog",
        "Marsh",
        "Swamp" ;
    skos:definition "Land saturated with water seasonally or permanently (marshes, swamps, bogs); high productivity and carbon storage." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Wetland / peatland" ;
    skos:scopeNote "Low-lying ecosystems saturated with water, including marshes, swamps, and peatlands, which serve as important carbon stores and biodiversity habitats, threatened by drainage and climate change." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000494> a skos:Concept ;
    skos:altLabel "Alpine tundra",
        "Arctic tundra",
        "High-latitude tundra",
        "Permafrost landscape" ;
    skos:definition "Extremely cold, treeless biome at high latitudes or altitudes, with permafrost and low-growing vegetation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Tundra" ;
    skos:scopeNote "A treeless biome found at high latitudes and elevations, characterised by permafrost, low vegetation, and extreme cold, with particular sensitivity to warming temperatures and permafrost thaw." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000495> a skos:Concept ;
    skos:altLabel "Agricultural area",
        "Agricultural land",
        "Arable land",
        "Cropland",
        "Pasture" ;
    skos:definition "Land used for agricultural production including arable crops, pasture, and mixed farming systems, representing a key interface between environmental conditions and food security." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Farmland" .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000496> a skos:Concept ;
    skos:altLabel "Boreal forest",
        "Coniferous forest",
        "Northern forest",
        "Subarctic forest",
        "Taiga" ;
    skos:definition "Cold, high-latitude coniferous forest with long, harsh winters; the largest terrestrial biome by land area. " ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Boreal forest / taiga" ;
    skos:scopeNote "The world's largest terrestrial biome, spanning high-latitude northern regions and characterised by coniferous forest, cold winters, and short growing seasons, playing a major role in global carbon storage." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000497> a skos:Concept ;
    skos:altLabel "Coral ecosystem",
        "Marine reef",
        "Reef ecosystem",
        "Tropical reef" ;
    skos:definition "Land saturated with water seasonally or permanently (marshes, swamps, bogs); high productivity and carbon storage." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Coral reef" ;
    skos:scopeNote "Shallow marine ecosystems built by calcium carbonate-secreting corals, supporting exceptional biodiversity and coastal protection but highly vulnerable to ocean warming and acidification." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000498> a skos:Concept ;
    skos:altLabel "Floodbank",
        "Riparian zone",
        "Riverbank",
        "Riverine habitat",
        "Streamside habitat" ;
    skos:definition "The transitional zone between terrestrial and aquatic environments along the banks of rivers, streams, and other watercourses, characterised by distinctive vegetation and sensitivity to flooding and drought." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Riparian" ;
    skos:scopeNote "\"Riparian\" is about the immediate riverside corridor and its ecology, while \"Delta/floodplain\" is about larger-scale depositional/flood landforms." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000501> a skos:Concept ;
    skos:altLabel "Alluvial plain",
        "Deltaic region",
        "Flood zone",
        "Floodplain",
        "River delta" ;
    skos:definition "Low-lying landforms formed by sediment deposition at river mouths or along river corridors, characterised by high agricultural productivity and biodiversity but acute vulnerability to flooding, sea-level rise, and storm surge." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Delta / floodplain" ;
    skos:scopeNote "\"Riparian\" is about the immediate riverside corridor and its ecology, while \"Delta/floodplain\" is about larger-scale depositional/flood landforms." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000502> a skos:Concept ;
    skos:altLabel "Coastal mangrove",
        "Intertidal forest",
        "Mangrove forest",
        "Mangrove swamp",
        "Mangrove wetland" ;
    skos:definition "alt-tolerant coastal forests in tropical/subtropical intertidal zones, important for coastal protection and nurseries for marine life." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Mangrove" ;
    skos:scopeNote "Coastal forest ecosystems dominated by salt-tolerant trees growing in intertidal zones of tropical and subtropical coastlines, providing habitat, carbon storage, and protection against storm surge and coastal erosion." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000660> a skos:Concept ;
    skos:altLabel "Amazon",
        "Jungle" ;
    skos:definition "Warm, high-rainfall regions near the equator with dense, multi-layered vegetation and the highest biodiversity of any biome." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Tropical rainforest" ;
    skos:scopeNote "Forest biome located in tropical latitudes (roughly between the Tropic of Cancer and Tropic of Capricorn) characterized by high, consistent rainfall and warm temperatures year-round, with no distinct dry season or a very short one." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000661> a skos:Concept ;
    skos:altLabel "Pampas",
        "Praries",
        "Seppes",
        "Veld" ;
    skos:definition "Moderate climate, low-to-moderate rainfall; grass-dominated with few trees (e.g., prairies, steppes)." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Temperate grassland" ;
    skos:scopeNote "Grassland biome located in mid-latitude regions with a temperate climate (warm-to-hot summers, cold winters, moderate and relatively even rainfall — typically too low to support forest but enough to prevent desert conditions). Dominated by grasses and herbaceous vegetation, with few or no trees, largely due to fire, grazing, and seasonal drought maintaining the grass-dominated state." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000662> a skos:Concept ;
    skos:definition "Mild, wet winters and hot, dry summers; shrubland and drought-adapted vegetation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Mediterranean / chaparral" ;
    skos:scopeNote "Biome and climate type found in mid-latitude coastal regions characterized by mild, wet winters and hot, dry summers. Vegetation is dominated by drought- and fire-adapted evergreen shrubs and small trees (sclerophyllous vegetation), shaped by the pronounced summer dry season." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000663> a skos:Concept ;
    skos:altLabel "Freshwater ecosystems",
        "Lakes",
        "Rivers" ;
    skos:definition "Low-salinity aquatic systems; includes flowing (lotic) and standing (lentic) water bodies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Freshwater (rivers, lakes)" ;
    skos:scopeNote "Inland water bodies including rivers, lakes, and streams, whose temperature, flow, and quality are sensitive to climate variability with consequences for drinking water and aquatic health." .

<https://vocab.destiny-evidence.org/geographic-feature-and-biomes/DSNY000664> a skos:Concept ;
    skos:altLabel "Coast",
        "Shoreline" ;
    skos:definition "Land saturated with water seasonally or permanently (marshes, swamps, bogs); high productivity and carbon storage." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature-and-biomes> ;
    skos:prefLabel "Coastal" .

