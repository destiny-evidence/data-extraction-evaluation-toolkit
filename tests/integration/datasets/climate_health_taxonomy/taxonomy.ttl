<https://vocab.destiny-evidence.org/health-outcomes/DSNY000309> a skos:Concept ;
    skos:altLabel "Malaria death",
        "NTD mortality",
        "Tropical disease mortality" ;
    skos:broader <https://vocab.destiny-evidence.org/health-outcomes/DSNY000306> ;
    skos:definition "Deaths caused by neglected tropical diseases and malaria, disproportionately affecting populations in low-income tropical settings." ;
    skos:inScheme <https://vocab.destiny-evidence.org/health-outcomes> ;
    skos:prefLabel "Neglected tropical diseases and malaria mortality" .

<https://vocab.destiny-evidence.org/health-outcomes/DSNY000310> a skos:Concept ;
