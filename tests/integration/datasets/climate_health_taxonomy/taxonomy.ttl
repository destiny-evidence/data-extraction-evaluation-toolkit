    skos:prefLabel "Agriculture, fishing, and forestry (Sector)" .

<https://vocab.destiny-evidence.org/sectors/DSNY000116> a skos:Concept ;
    skos:altLabel "Construction",
        "Housing",
        "Residential sector" ;
    skos:definition "The sector covering residential and commercial buildings, housing provision, and construction." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Buildings / housing (Sector)" .

<https://vocab.destiny-evidence.org/sectors/DSNY000117> a skos:Concept ;
    skos:altLabel "Academic institutions",
        "Learning sector",
        "Schools" ;
    skos:definition "The sector encompassing formal and informal education systems, including schools, universities, and vocational institutions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Education (Sector)" .

<https://vocab.destiny-evidence.org/sectors/DSNY000118> a skos:Concept ;
    skos:altLabel "Energy sector",
        "Mining",
        "Power generation" ;
    skos:definition "The sector covering electricity generation, fuel production, and resource extraction, including both fossil fuel and renewable energy systems." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Energy and extractives (Sector)" .

<https://vocab.destiny-evidence.org/sectors/DSNY000119> a skos:Concept ;
    skos:altLabel "Banking",
        "Financial sector",
        "Investment" ;
    skos:definition "The sector encompassing banking, insurance, investment, and financial services, including public and private finance mechanisms." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Finance (Sector)" .

<https://vocab.destiny-evidence.org/sectors/DSNY000120> a skos:Concept ;
    skos:altLabel "Health sector",
        "Health systems",
        "Medical services" ;
    skos:definition "The sector providing medical care, public health services, and health infrastructure, including hospitals, primary care, and preventive health services." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
